{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mp7.walk": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "transitions": [{"walk": "v.mp7 && q.is_moving && !q.is_sprinting && !q.is_sneaking"}]
        },
        "walk": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"universal_walk": "v.mp7"}, {"walk_delay_2": "v.mp7"}],
          "transitions": [
            {"delay": "v.mp7 && q.is_sprinting"},
            {"delay": "v.mp7 && q.is_sneaking"},
            {"delay": "v.mp7 && !q.is_moving && !q.is_sprinting && q.any_animation_finished"}
          ]
        },
        "delay": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"walk_delay": "v.mp7"}],
          "transitions": [{"setup": "v.mp7 && q.any_animation_finished"}]
        }
      }
    },
    "controller.animation.mp7.tp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [{"mp7_tp_hold": "v.mp7"}],
          "transitions": [
            {"sprint": "v.mp7 && q.is_sprinting && !q.is_using_item"},
            {"sight": "v.mp7 && q.is_sneaking"},
            {"hold": "v.mp7 && q.is_using_item"}
          ]
        },
        "sprint": {
          "animations": [{"mp7_tp_sprint": "v.mp7"}],
          "transitions": [
            {"hold": "v.mp7 && !q.is_sprinting"},
            {"hold": "v.mp7 && q.is_using_item"},
            {"sight": "v.mp7 && q.is_sneaking"}
          ]
        },
        "sight": {"animations": [{"mp7_tp_sight": "v.mp7"}], "transitions": [{"hold": "v.mp7 && !q.is_sneaking"}]}
      }
    },
    "controller.animation.mp7.fp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"mp7_fp_hold": "v.mp7"}],
          "transitions": [
            {"reload": "v.mp7emp && q.mark_variant == 1"},
            {"inspect": "v.mp7b && q.skin_id == 1 && !q.is_sneaking"},
            {"reloadtac": "v.mp7 && q.mark_variant == 2"},
            {"sprint": "v.mp7 && q.is_sprinting && !q.is_using_item"},
            {"sight": "v.mp7 && q.is_sneaking"},
            {"hold": "v.mp7 && q.is_using_item"}
          ]
        },
        "inspect": {
          "animations": [{"mp7_fp_inspect": "v.mp7"}],
          "transitions": [
            {
              "hold": "(v.mp7 && q.any_animation_finished) || (v.mp7 && q.is_using_item) || (v.mp7 && q.is_sneaking)"
            }
          ]
        },
        "sprint": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"mp7_fp_sprint": "v.mp7"}],
          "transitions": [
            {"hold": "v.mp7 && !q.is_sprinting"},
            {"hold": "v.mp7 && q.is_using_item"},
            {"reload": "v.mp7emp && q.mark_variant == 1"},
            {"reloadtac": "v.mp7 && q.mark_variant == 2"},
            {"sight": "v.mp7 && q.is_sneaking"}
          ]
        },
        "reload": {
          "animations": [{"mp7_fp_reload": "v.mp7"}],
          "transitions": [{"hold": "v.mp7 && (q.any_animation_finished || q.mark_variant != 1)"}]
        },
        "reloadtac": {
          "animations": [{"mp7_fp_reload_tac": "v.mp7"}],
          "transitions": [{"hold": "v.mp7 && q.any_animation_finished"}, {"hold": "v.mp7 && q.mark_variant != 2"}]
        },
        "sight": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"mp7_fp_sight": "v.mp7"}],
          "transitions": [
            {"hold": "v.mp7 && !q.is_sneaking"},
            {"reloadtac": "v.mp7 && q.mark_variant == 2"},
            {"reload": "v.mp7emp && q.mark_variant == 1"}
          ]
        }
      }
    }
  }
}
