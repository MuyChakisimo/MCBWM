{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "krep:taczmuzzlejet",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/tacz_muzzleflash_atlas"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.silenced = q.is_item_name_any('slot.inventory', 5, 'att:silencer') || q.is_item_name_any('slot.inventory', 3, 'att:silencer'); v.fwd = -1;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 2
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, "v.fwd * (0.25 + v.particle_random_4 * 0.15)"],
				"direction": [0, 0, "v.fwd"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.05 + v.particle_random_3 * 0.03"
			},
			"minecraft:particle_initial_speed": 0.5,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.silenced ? 0 : (0.45 + v.particle_random_1 * 0.3)",
					"v.silenced ? 0 : (0.16 + v.particle_random_1 * 0.08)"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 512,
					"texture_height": 512,
					"uv": [
						"math.mod(math.floor(v.particle_random_2 * 11.99), 4) * 128",
						"math.floor(math.floor(v.particle_random_2 * 11.99) / 4) * 128"
					],
					"uv_size": [128, 128]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					1,
					"0.97 - 0.4 * v.particle_age / v.particle_lifetime",
					"0.65 - 0.5 * v.particle_age / v.particle_lifetime",
					"math.clamp(1.6 - 1.6 * v.particle_age / v.particle_lifetime, 0, 1)"
				]
			}
		}
	}
}
