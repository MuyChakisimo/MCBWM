{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m700": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m700' && q.is_using_item) || query.get_equipped_item_name=='m700_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m700 5",
            "/event entity @s[hasitem={item=krep:m700, location=slot.weapon.mainhand}] krep:noreload",
            "@s m700:normal"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m700.31": "query.get_equipped_item_name=='m700' && query.is_using_item && query.scoreboard('m700') == 0"
            }
          ],
          "on_entry": ["/function m700"]
        },
        "m700.31": {
          "animations": ["m700shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m700=0}] slot.weapon.mainhand 1 krep:m700_emp 1 0"]
        }
      }
    },
    "controller.animation.m700.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m700_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m700' && variable.attack_time > 0.0f && query.scoreboard('m700') <= 4 && q.mark_variant != 3 && q.property('krep:ammoreload')!=1) || (q.mark_variant == 2 && query.get_equipped_item_name=='m700' && q.property('krep:ammoreload')!=1)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m700quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m700' && q.property('krep:ammoreload') == 340"},
            {
              "reload.tac": "query.get_equipped_item_name=='m700' && q.property('krep:ammoreload') >= 341"
            },
            {"setup": "query.get_equipped_item_name!='m700'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m700quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m700_emp' && q.property('krep:ammoreload') == 340"
            },
            {
              "reload": "query.get_equipped_item_name=='m700_emp' && q.property('krep:ammoreload') >= 341"
            },
            {"setup": "query.get_equipped_item_name!='m700'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m700reload": "query.get_equipped_item_name('main_hand')=='m700_emp' || query.get_equipped_item_name('main_hand')=='m700'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m700_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m700reloadtac": "query.get_equipped_item_name('main_hand')=='m700_emp' || query.get_equipped_item_name('main_hand')=='m700'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m700'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m700", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m700' || query.get_equipped_item_name=='m700_emp'"
            }
          ]
        }
      }
    }
  }
}
