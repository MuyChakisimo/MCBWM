{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.rpg": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='rpg' && q.is_using_item) || query.get_equipped_item_name=='rpg_emp'"
            }
          ],
          "on_entry": ["@s[hasitem={item=krep:rpg, location=slot.weapon.mainhand}] krep:noreload"]
        },
        "setup": {
          "transitions": [{"rpg.30": "query.get_equipped_item_name=='rpg' && query.is_using_item && q.is_sneaking"}],
          "on_entry": []
        },
        "rpg.31": {
          "animations": ["rpgshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s slot.weapon.mainhand 1 krep:rpg_emp 1 0"]
        },
        "rpg.30": {
          "animations": ["rpgshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:rpg_fire",
            "/playsound rpg.shoot @a[r=30]",
            "/replaceitem entity @s slot.weapon.mainhand 1 krep:rpg_emp 1 0",
            "/title @s actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.rpg.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [{"trigger.reload": "query.get_equipped_item_name=='rpg_emp' && q.is_using_item"}]
        },
        "trigger.reload": {
          "on_entry": [
            "/event entity @s[hasitem={item=krep:rpgrocket,quantity=0}] rpgreload0",
            "/event entity @s[hasitem={item=krep:rpgrocket,quantity=1..}] rpgreload1",
            "@s krep:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='rpg_emp' && q.property('krep:ammoreload') == 1000"
            },
            {
              "reload": "query.get_equipped_item_name=='rpg_emp' && q.property('krep:ammoreload') >= 1001"
            },
            {"setup": "query.get_equipped_item_name=='rpg'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "rpgreload": "query.get_equipped_item_name('main_hand')=='rpg_emp' || query.get_equipped_item_name('main_hand')=='rpg'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='rpg_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='rpg' || query.get_equipped_item_name=='rpg_emp'"
            }
          ]
        }
      }
    }
  }
}
