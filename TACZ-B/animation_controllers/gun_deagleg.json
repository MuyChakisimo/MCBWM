              "reload": "query.get_equipped_item_name=='deagleg_emp' && q.property('krep:ammoreload') >= 601"
            },
            {"setup": "query.get_equipped_item_name!='deagleg'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "deaglegreload": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==0"
            },
            {
              "deaglegreload1": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==1"
            },
            {
              "deaglegreload2": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==2"
            },
            {
              "deaglegreload3": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==3"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='deagleg_emp'"},
            {"reloadfinish": "query.any_animation_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "deaglegreloadtac": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==0"
            },
            {
              "deaglegreloadtac1": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==1"
            },
            {
              "deaglegreloadtac2": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==2"
            },
            {
              "deaglegreloadtac3": "(query.get_equipped_item_name('main_hand')=='deagleg_emp' || query.get_equipped_item_name('main_hand')=='deagleg') && q.property('krep:magazine')==3"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='deagleg'"},
            {"reloadfinish": "query.any_animation_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function deagleg", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='deagleg' || query.get_equipped_item_name=='deagleg_emp'"
            }
          ]
        }
      }
