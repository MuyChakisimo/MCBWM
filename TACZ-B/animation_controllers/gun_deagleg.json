{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.deagleg": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='deagleg' && q.is_using_item) || query.get_equipped_item_name=='deagleg_emp'"
            }
          ],
          "on_entry": ["@s[hasitem={item=krep:deagleg, location=slot.weapon.mainhand}] krep:noreload"]
        },
        "setup": {
          "transitions": [
            {
              "deagleg.30": "query.get_equipped_item_name=='deagleg' && query.is_using_item && query.scoreboard('deagleg') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')==0"
            },
            {
              "deagleg.30s": "query.get_equipped_item_name=='deagleg' && query.is_using_item && query.scoreboard('deagleg') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')==1"
            },
            {
              "deagleg.31": "query.get_equipped_item_name=='deagleg' && query.is_using_item && query.scoreboard('deagleg') == 0"
            }
          ],
          "on_entry": ["/function deagleg"]
        },
        "deagleg.31": {
          "animations": ["deaglegshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={deagleg=0}] slot.weapon.mainhand 1 krep:deagleg_emp 1 0"]
        },
        "deagleg.30": {
          "animations": ["deaglegshoot"],
          "transitions": [{"setup": "query.all_animations_finished && !q.is_using_item"}],
          "on_entry": [
            "@s krep:deagleg_fire",
            "@s krep:deagleg_range",
            "/scoreboard players remove @s[scores={deagleg=1..}] deagleg 1",
            "/playsound deagle.shoot @a[r=30]",
            "/replaceitem entity @s[scores={deagleg=0}] slot.weapon.mainhand 1 krep:deagleg_emp 1 0",
            "/title @s[scores={deagleg=0}] actionbar No Ammunition"
          ]
        },
        "deagleg.30s": {
          "animations": ["deaglegshoot"],
          "transitions": [{"setup": "query.all_animations_finished && !q.is_using_item"}],
          "on_entry": [
            "@s krep:deagleg_fire",
            "@s krep:deagleg_range",
            "/scoreboard players remove @s[scores={deagleg=1..}] deagleg 1",
            "/playsound deagle.suppress @a[r=15]",
            "/replaceitem entity @s[scores={deagleg=0}] slot.weapon.mainhand 1 krep:deagleg_emp 1 0",
            "/title @s[scores={deagleg=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.deagleg.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='deagleg_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==0"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='deagleg' && variable.attack_time > 0.0f && query.scoreboard('deagleg') <= 9 && q.mark_variant != 3 && q.property('krep:magazine')==0) || (q.mark_variant == 2 && query.get_equipped_item_name=='deagleg' && q.property('krep:magazine')==0)"
            },
            {
              "trigger.reload1": "query.get_equipped_item_name=='deagleg_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==1"
            },
            {
              "trigger.tac1": "(query.get_equipped_item_name=='deagleg' && variable.attack_time > 0.0f && query.scoreboard('deagleg') <= 11 && q.mark_variant != 3 && q.property('krep:magazine')==1) || (q.mark_variant == 2 && query.get_equipped_item_name=='deagleg' && q.property('krep:magazine')==1)"
            },
            {
              "trigger.reload2": "query.get_equipped_item_name=='deagleg_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==2"
            },
            {
              "trigger.tac2": "(query.get_equipped_item_name=='deagleg' && variable.attack_time > 0.0f && query.scoreboard('deagleg') <= 14 && q.mark_variant != 3 && q.property('krep:magazine')==2) || (q.mark_variant == 2 && query.get_equipped_item_name=='deagleg' && q.property('krep:magazine')==2)"
            },
            {
              "trigger.reload3": "query.get_equipped_item_name=='deagleg_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==3"
            },
            {
              "trigger.tac3": "(query.get_equipped_item_name=='deagleg' && variable.attack_time > 0.0f && query.scoreboard('deagleg') <= 16 && q.mark_variant != 3 && q.property('krep:magazine')==3) || (q.mark_variant == 2 && query.get_equipped_item_name=='deagleg' && q.property('krep:magazine')==3)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function deaglegquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='deagleg' && q.property('krep:ammoreload') == 600"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='deagleg' && q.property('krep:ammoreload') >= 601"
            },
            {"setup": "query.get_equipped_item_name!='deagleg'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function deaglegquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='deagleg_emp' && q.property('krep:ammoreload') == 600"
            },
            {
              "reload": "query.get_equipped_item_name=='deagleg_emp' && q.property('krep:ammoreload') >= 601"
            },
            {"setup": "query.get_equipped_item_name!='deagleg'"}
          ]
        },
        "trigger.tac1": {
          "on_entry": ["/function deaglegquantity1", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='deagleg' && q.property('krep:ammoreload') == 600"
            },
