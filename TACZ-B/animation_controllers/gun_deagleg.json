{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.deagleg": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='deagleg' && q.is_using_item) || query.get_equipped_item_name=='deagleg_emp'"
            }
          ],
          "on_entry": [
            "/event entity @s[hasitem={item=krep:deagleg, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "deagleg.31": "query.get_equipped_item_name=='deagleg' && query.is_using_item && query.scoreboard('deagleg') == 0"
            }
          ],
          "on_entry": ["/function deagleg"]
        },
        "deagleg.31": {
          "animations": ["deaglegshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={deagleg=0}] slot.weapon.mainhand 1 krep:deagleg_emp 1 0"]
        }
      }
    }
  }
}
