{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.taurus500": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='taurus500' && q.is_using_item) || query.get_equipped_item_name=='taurus500_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s taurus500 5",
            "/event entity @s[hasitem={item=krep:taurus500, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {"transitions": [], "on_entry": ["/function taurus500"]}
      }
    }
  }
}
