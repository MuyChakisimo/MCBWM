{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.type81": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='type81' && q.is_using_item) || query.get_equipped_item_name=='type81_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s type81 30",
            "/event entity @s[hasitem={item=krep:type81, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {"transitions": [], "on_entry": ["/function type81"]}
      }
    }
  }
}
