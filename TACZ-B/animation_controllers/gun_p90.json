{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.p90": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='p90' && q.is_using_item) || query.get_equipped_item_name=='p90_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s p90 50",
            "/event entity @s[hasitem={item=krep:p90, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "p90.31": "query.get_equipped_item_name=='p90' && query.is_using_item && query.scoreboard('p90') == 0"
            }
          ],
          "on_entry": ["/function p90"]
        },
        "p90.31": {
          "animations": ["p90shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={p90=0}] slot.weapon.mainhand 1 krep:p90_emp 1 0"]
        }
      }
    },
    "controller.animation.p90.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='p90_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='p90' && variable.attack_time > 0.0f && query.scoreboard('p90') <= 48 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='p90')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function p90quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='p90' && q.property('krep:ammoreload') == 180"},
            {
              "reload.tac": "query.get_equipped_item_name=='p90' && q.property('krep:ammoreload') >= 181"
            },
            {"setup": "query.get_equipped_item_name!='p90'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function p90quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='p90_emp' && q.property('krep:ammoreload') == 180"
            },
            {"setup": "query.get_equipped_item_name!='p90_emp'"},
            {
              "reload": "query.get_equipped_item_name=='p90_emp' && q.property('krep:ammoreload') >= 181"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "p90reload": "query.get_equipped_item_name('main_hand')=='p90_emp' || query.get_equipped_item_name('main_hand')=='p90'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='p90_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "p90reloadtac": "query.get_equipped_item_name('main_hand')=='p90_emp' || query.get_equipped_item_name('main_hand')=='p90'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='p90'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function p90", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='p90' || query.get_equipped_item_name=='p90_emp'"
            }
          ]
        }
      }
    }
  }
}
