{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m249": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m249' && q.is_using_item) || query.get_equipped_item_name=='m249_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m249 100",
            "/event entity @s[hasitem={item=krep:m249, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m249.30": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2"
            },
            {
              "m249.31": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') == 0"
            }
          ],
          "on_entry": ["/function m249"]
        },
        "m249.31": {
          "animations": ["m249shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m249=0}] slot.weapon.mainhand 1 krep:m249_emp 1 0"]
        },
        "m249.30": {
          "animations": ["m249shoot"],
          "transitions": [
            {
              "delay.30": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {"setup": "query.scoreboard('m249') == 0"}
          ],
          "on_entry": [
            "@s krep:m249_fire",
            "/function m249",
            "/playsound m249.shoot @a[r=30]",
            "/scoreboard players set @s[scores={m249=101..}] m249 100",
            "/scoreboard players remove @s[scores={m249=1..}] m249 1",
            "/replaceitem entity @s[scores={m249=0}] slot.weapon.mainhand 1 krep:m249_emp 1 0",
            "/title @s[scores={m249=0}] actionbar No Ammunition"
          ]
        },
        "delay.30": {
          "animations": ["m249shoot"],
          "transitions": [
            {
              "m249.29": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {"setup": "query.scoreboard('m249') == 0"}
          ]
        },
        "m249.29": {
          "transitions": [
            {
              "m249.30": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2"
            },
            {"setup": "query.scoreboard('m249') == 0"}
          ],
          "on_entry": [
            "@s krep:m249_fire",
            "/function m249",
            "/playsound m249.shoot @a[r=30]",
            "/scoreboard players set @s[scores={m249=101..}] m249 100",
            "/scoreboard players remove @s[scores={m249=1..}] m249 1",
            "/replaceitem entity @s[scores={m249=0}] slot.weapon.mainhand 1 krep:m249_emp 1 0",
            "/title @s[scores={m249=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.m249.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m249_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m249' && variable.attack_time > 0.0f && query.scoreboard('m249') <= 99) || (query.get_equipped_item_name=='m249' && q.mark_variant == 2)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m249quantity", "@s krep:noreload", "@s evolys:reset"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m249' && q.property('krep:ammoreload') == 0"},
            {
              "reload.tac": "query.get_equipped_item_name=='m249' && q.property('krep:ammoreload') >= 1"
            },
            {"setup": "query.get_equipped_item_name!='m249'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m249quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m249_emp' && q.property('krep:ammoreload') == 0"
            },
            {
              "reload": "query.get_equipped_item_name=='m249_emp' && q.property('krep:ammoreload') >= 1"
            },
            {"setup": "query.get_equipped_item_name!='m249'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m249reload": "query.get_equipped_item_name('main_hand')=='m249_emp' || query.get_equipped_item_name('main_hand')=='m249'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m249_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m249reloadtac": "query.get_equipped_item_name('main_hand')=='m249_emp' || query.get_equipped_item_name('main_hand')=='m249'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m249'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m249", "@s evolys:reset"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m249' || query.get_equipped_item_name=='m249_emp'"
            }
          ]
        }
      }
    }
  }
}
