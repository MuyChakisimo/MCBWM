{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.qbz191": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='qbz191' && q.is_using_item) || query.get_equipped_item_name=='qbz191_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s qbz191 30",
            "/event entity @s[hasitem={item=krep:qbz191, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "qbz191.31": "query.get_equipped_item_name=='qbz191' && query.is_using_item && query.scoreboard('qbz191') == 0"
            }
          ],
          "on_entry": ["/function qbz191"]
        },
        "qbz191.31": {
          "animations": ["qbz191shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={qbz191=0}] slot.weapon.mainhand 1 krep:qbz191_emp 1 0"]
        }
      }
    }
  }
}
