{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.aug": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='aug' && q.is_using_item) || query.get_equipped_item_name=='aug_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s aug 30",
            "/event entity @s[hasitem={item=krep:aug, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "aug.31": "query.get_equipped_item_name=='aug' && query.is_using_item && query.scoreboard('aug') == 0"
            }
          ],
          "on_entry": ["/function aug"]
        },
        "aug.31": {
          "animations": ["augshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={aug=0}] slot.weapon.mainhand 1 krep:aug_emp 1 0"]
        }
      }
    }
  }
}
