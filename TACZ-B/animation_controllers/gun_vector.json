{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.vector": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='vector' && q.is_using_item) || query.get_equipped_item_name=='vector_emp'"
            }
          ],
          "on_entry": ["@s[hasitem={item=krep:vector, location=slot.weapon.mainhand}] krep:noreload"]
        },
        "setup": {
          "transitions": [
            {
              "vector.30": "query.get_equipped_item_name=='vector' && query.is_using_item && query.scoreboard('vector') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle') <= 3"
            },
            {
              "vector.30s": "query.get_equipped_item_name=='vector' && query.is_using_item && query.scoreboard('vector') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle') >= 4"
            },
            {
              "vector.31": "query.get_equipped_item_name=='vector' && query.is_using_item && query.scoreboard('vector') == 0"
            }
          ],
          "on_entry": ["/function vector"]
        },
        "vector.31": {
          "animations": ["vectorshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={vector=0}] slot.weapon.mainhand 1 krep:vector_emp 1 0"]
        },
        "vector.30": {
          "transitions": [
            {"setup": "query.get_equipped_item_name=='vector' && !query.is_using_item"},
            {"setup": "query.scoreboard('vector') == 0"},
            {
              "vector.29": "query.get_equipped_item_name=='vector' && query.is_using_item && query.scoreboard('vector') >= 1 && q.mark_variant != 2"
            }
          ],
          "on_entry": [
            "@s krep:vector_fire",
            "@s krep:vector_range",
            "/scoreboard players remove @s[scores={vector=1..}] vector 1",
            "/playsound vector.shoot @a[r=30]",
            "/replaceitem entity @s[scores={vector=0}] slot.weapon.mainhand 1 krep:vector_emp 1 0",
            "/title @s[scores={vector=0}] actionbar No Ammunition",
            "/function vector"
          ]
        },
        "vector.29": {
          "transitions": [
            {"setup": "query.scoreboard('vector') == 0"},
            {"setup": "query.get_equipped_item_name=='vector' && !query.is_using_item"},
            {
              "vector.30": "query.get_equipped_item_name=='vector' && query.is_using_item && query.scoreboard('vector') >= 1 && q.mark_variant != 2"
            }
          ],
          "on_entry": [
            "@s krep:vector_fire",
            "@s krep:vector_range",
            "/scoreboard players remove @s[scores={vector=1..}] vector 1",
            "/playsound vector.shoot @a[r=30]",
            "/replaceitem entity @s[scores={vector=0}] slot.weapon.mainhand 1 krep:vector_emp 1 0",
            "/title @s[scores={vector=0}] actionbar No Ammunition",
            "/function vector"
          ]
        },
        "vector.30s": {
          "transitions": [
            {"setup": "query.get_equipped_item_name=='vector' && !query.is_using_item"},
            {"setup": "query.scoreboard('vector') == 0"},
            {
              "vector.29s": "query.get_equipped_item_name=='vector' && query.is_using_item && query.scoreboard('vector') >= 1 && q.mark_variant != 2"
            }
          ],
          "on_entry": [
            "@s krep:vector_fire",
            "@s krep:vector_range",
            "/scoreboard players remove @s[scores={vector=1..}] vector 1",
            "/playsound vector.suppress @a[r=15]",
            "/replaceitem entity @s[scores={vector=0}] slot.weapon.mainhand 1 krep:vector_emp 1 0",
            "/title @s[scores={vector=0}] actionbar No Ammunition",
            "/function vector"
          ]
        },
        "vector.29s": {
          "transitions": [
            {"setup": "query.scoreboard('vector') == 0"},
            {"setup": "query.get_equipped_item_name=='vector' && !query.is_using_item"},
            {
              "vector.30s": "query.get_equipped_item_name=='vector' && query.is_using_item && query.scoreboard('vector') >= 1 && q.mark_variant != 2"
            }
          ],
          "on_entry": [
            "@s krep:vector_fire",
            "@s krep:vector_range",
            "/scoreboard players remove @s[scores={vector=1..}] vector 1",
            "/playsound vector.suppress @a[r=15]",
            "/replaceitem entity @s[scores={vector=0}] slot.weapon.mainhand 1 krep:vector_emp 1 0",
            "/title @s[scores={vector=0}] actionbar No Ammunition",
            "/function vector"
          ]
        }
      }
    },
    "controller.animation.vector.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='vector_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==0"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='vector' && variable.attack_time > 0.0f && query.scoreboard('vector') <= 18 && q.mark_variant != 3 && q.property('krep:magazine')==0) || (q.mark_variant == 2 && query.get_equipped_item_name=='vector' && q.property('krep:magazine')==0)"
            },
            {
              "trigger.reload1": "query.get_equipped_item_name=='vector_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==1"
            },
            {
              "trigger.tac1": "(query.get_equipped_item_name=='vector' && variable.attack_time > 0.0f && query.scoreboard('vector') <= 28 && q.mark_variant != 3 && q.property('krep:magazine')==1) || (q.mark_variant == 2 && query.get_equipped_item_name=='vector' && q.property('krep:magazine')==1)"
            },
            {
              "trigger.reload2": "query.get_equipped_item_name=='vector_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==2"
            },
            {
              "trigger.tac2": "(query.get_equipped_item_name=='vector' && variable.attack_time > 0.0f && query.scoreboard('vector') <= 38 && q.mark_variant != 3 && q.property('krep:magazine')==2) || (q.mark_variant == 2 && query.get_equipped_item_name=='vector' && q.property('krep:magazine')==2)"
            },
            {
              "trigger.reload3": "query.get_equipped_item_name=='vector_emp' && variable.attack_time == 0.0 && q.is_using_item && q.property('krep:magazine')==3"
            },
            {
              "trigger.tac3": "(query.get_equipped_item_name=='vector' && variable.attack_time > 0.0f && query.scoreboard('vector') <= 48 && q.mark_variant != 3 && q.property('krep:magazine')==3) || (q.mark_variant == 2 && query.get_equipped_item_name=='vector' && q.property('krep:magazine')==3)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function vectorquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function vectorquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "trigger.tac1": {
          "on_entry": ["/function vectorquantity1", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "trigger.reload1": {
          "on_entry": ["/function vectorquantity1", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "trigger.tac2": {
          "on_entry": ["/function vectorquantity2", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "trigger.reload2": {
          "on_entry": ["/function vectorquantity2", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "trigger.tac3": {
          "on_entry": ["/function vectorquantity3", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='vector' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "trigger.reload3": {
          "on_entry": ["/function vectorquantity3", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') == 80"
            },
            {
              "reload": "query.get_equipped_item_name=='vector_emp' && q.property('krep:ammoreload') >= 81"
            },
            {"setup": "query.get_equipped_item_name!='vector'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "vectorreload": "query.get_equipped_item_name('main_hand')=='vector_emp' || query.get_equipped_item_name('main_hand')=='vector'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='vector_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "vectorreloadtac": "query.get_equipped_item_name('main_hand')=='vector_emp' || query.get_equipped_item_name('main_hand')=='vector'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='vector'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function vector", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='vector' || query.get_equipped_item_name=='vector_emp'"
            }
          ]
        }
      }
    }
  }
}
