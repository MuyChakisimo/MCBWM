{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.saiga12": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='saiga12' && q.is_using_item) || query.get_equipped_item_name=='saiga12_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s saiga12 5",
            "/event entity @s[hasitem={item=krep:saiga12, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "saiga12.31": "query.get_equipped_item_name=='saiga12' && query.is_using_item && query.scoreboard('saiga12') == 0"
            }
          ],
          "on_entry": ["/function saiga12"]
        },
        "saiga12.31": {
          "animations": ["saiga12shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={saiga12=0}] slot.weapon.mainhand 1 krep:saiga12_emp 1 0"]
        }
      }
    },
    "controller.animation.saiga12.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='saiga12_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='saiga12' && variable.attack_time > 0.0f && query.scoreboard('saiga12') <= 4 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='saiga12')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function saiga12quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='saiga12' && q.property('krep:ammoreload') == 670"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='saiga12' && q.property('krep:ammoreload') >= 671"
            },
            {"setup": "query.get_equipped_item_name!='saiga12'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function saiga12quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='saiga12_emp' && q.property('krep:ammoreload') == 670"
            },
            {
              "reload": "query.get_equipped_item_name=='saiga12_emp' && q.property('krep:ammoreload') >= 671"
            },
            {"setup": "query.get_equipped_item_name!='saiga12'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "saiga12reload": "query.get_equipped_item_name('main_hand')=='saiga12_emp' || query.get_equipped_item_name('main_hand')=='saiga12'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='saiga12_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "saiga12reloadtac": "query.get_equipped_item_name('main_hand')=='saiga12_emp' || query.get_equipped_item_name('main_hand')=='saiga12'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='saiga12'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function saiga12", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='saiga12' || query.get_equipped_item_name=='saiga12_emp'"
            }
          ]
        }
      }
    }
  }
}
