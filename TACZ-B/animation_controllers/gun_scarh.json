{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scarh": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='scarh' && q.is_using_item) || query.get_equipped_item_name=='scarh_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s scarh 20",
            "/event entity @s[hasitem={item=krep:scarh, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "scarh.30": "query.get_equipped_item_name=='scarh' && query.is_using_item && query.scoreboard('scarh') >= 1 && q.mark_variant != 2"
            },
            {
              "scarh.31": "query.get_equipped_item_name=='scarh' && query.is_using_item && query.scoreboard('scarh') == 0"
            }
          ],
          "on_entry": ["/function scarh"]
        },
        "scarh.31": {
          "animations": ["scarhshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={scarh=0}] slot.weapon.mainhand 1 krep:scarh_emp 1 0"]
        },
        "scarh.30": {
          "animations": ["scarhshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:scarh_fire",
            "/scoreboard players set @s[scores={scarh=22..}] scarh 21",
            "/scoreboard players remove @s[scores={scarh=1..21}] scarh 1",
            "/playsound scarh.shoot @a[r=30]",
            "/replaceitem entity @s[scores={scarh=0}] slot.weapon.mainhand 1 krep:scarh_emp 1 0",
            "/title @s[scores={scarh=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.scarh.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='scarh_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='scarh' && variable.attack_time > 0.0f && query.scoreboard('scarh') <= 19 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='scarh')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function scarhquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='scarh' && q.property('krep:ammoreload') == 150"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='scarh' && q.property('krep:ammoreload') >= 151"
            },
            {"setup": "query.get_equipped_item_name!='scarh'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function scarhquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='scarh_emp' && q.property('krep:ammoreload') == 150"
            },
            {"setup": "query.get_equipped_item_name!='scarh_emp'"},
            {
              "reload": "query.get_equipped_item_name=='scarh_emp' && q.property('krep:ammoreload') >= 151"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "scarhreload": "query.get_equipped_item_name('main_hand')=='scarh_emp' || query.get_equipped_item_name('main_hand')=='scarh'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='scarh_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "scarhreloadtac": "query.get_equipped_item_name('main_hand')=='scarh_emp' || query.get_equipped_item_name('main_hand')=='scarh'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='scarh'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function scarh", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='scarh' || query.get_equipped_item_name=='scarh_emp'"
            }
          ]
        }
      }
    }
  }
}
