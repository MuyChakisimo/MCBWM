{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scarl": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='scarl' && q.is_using_item) || query.get_equipped_item_name=='scarl_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s scarl 30",
            "/event entity @s[hasitem={item=krep:scarl, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "scarl.31": "query.get_equipped_item_name=='scarl' && query.is_using_item && query.scoreboard('scarl') == 0"
            }
          ],
          "on_entry": ["/function scarl"]
        },
        "scarl.31": {
          "animations": ["scarlshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={scarl=0}] slot.weapon.mainhand 1 krep:scarl_emp 1 0"]
        }
      }
    },
    "controller.animation.scarl.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='scarl_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='scarl' && variable.attack_time > 0.0f && query.scoreboard('scarl') <= 28 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='scarl')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function scarlquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='scarl' && q.property('krep:ammoreload') == 370"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='scarl' && q.property('krep:ammoreload') >= 371"
            },
            {"setup": "query.get_equipped_item_name!='scarl'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function scarlquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='scarl_emp' && q.property('krep:ammoreload') == 370"
            },
            {
              "reload": "query.get_equipped_item_name=='scarl_emp' && q.property('krep:ammoreload') >= 371"
            },
            {"setup": "query.get_equipped_item_name!='scarl'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "scarlreload": "query.get_equipped_item_name('main_hand')=='scarl_emp' || query.get_equipped_item_name('main_hand')=='scarl'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='scarl_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "scarlreloadtac": "query.get_equipped_item_name('main_hand')=='scarl_emp' || query.get_equipped_item_name('main_hand')=='scarl'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='scarl'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function scarl"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='scarl' || query.get_equipped_item_name=='scarl_emp'"
            }
          ]
        }
      }
    }
  }
}
