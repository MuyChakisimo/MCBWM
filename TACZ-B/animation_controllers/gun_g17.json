{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.g17": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='g17' && q.is_using_item) || query.get_equipped_item_name=='g17_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s g17 17",
            "/event entity @s[hasitem={item=krep:g17, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "g17.31": "query.get_equipped_item_name=='g17' && query.is_using_item && query.scoreboard('g17') == 0"
            }
          ],
          "on_entry": ["/function g17"]
        },
        "g17.31": {
          "animations": ["g17shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={g17=0}] slot.weapon.mainhand 1 krep:g17_emp 1 0"]
        }
      }
    }
  }
}
