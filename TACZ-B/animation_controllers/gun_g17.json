{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.g17": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='g17' && q.is_using_item) || query.get_equipped_item_name=='g17_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s g17 17",
            "/event entity @s[hasitem={item=krep:g17, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "g17.31": "query.get_equipped_item_name=='g17' && query.is_using_item && query.scoreboard('g17') == 0"
            }
          ],
          "on_entry": ["/function g17"]
        },
        "g17.31": {
          "animations": ["g17shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={g17=0}] slot.weapon.mainhand 1 krep:g17_emp 1 0"]
        }
      }
    },
    "controller.animation.g17.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='g17_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='g17' && variable.attack_time > 0.0f && query.scoreboard('g17') <= 15 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='g17')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function g17quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='g17' && q.property('krep:ammoreload') == 350"},
            {
              "reload.tac": "query.get_equipped_item_name=='g17' && q.property('krep:ammoreload') >= 351"
            },
            {"setup": "query.get_equipped_item_name!='g17'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function g17quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='g17_emp' && q.property('krep:ammoreload') == 350"
            },
            {
              "reload": "query.get_equipped_item_name=='g17_emp' && q.property('krep:ammoreload') >= 351"
            },
            {"setup": "query.get_equipped_item_name!='g17'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "g17reload": "query.get_equipped_item_name('main_hand')=='g17_emp' || query.get_equipped_item_name('main_hand')=='g17'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='g17_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "g17reloadtac": "query.get_equipped_item_name('main_hand')=='g17_emp' || query.get_equipped_item_name('main_hand')=='g17'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='g17'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function g17", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='g17' || query.get_equipped_item_name=='g17_emp'"
            }
          ]
        }
      }
    }
  }
}
