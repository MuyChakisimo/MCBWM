{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.awp": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='awp' && q.is_using_item) || query.get_equipped_item_name=='awp_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s awp 5",
            "@s[hasitem={item=krep:awp, location=slot.weapon.mainhand}] krep:noreload",
            "@s awp:normal"
          ]
        },
        "jawir": {
          "animations": ["awpdelay"],
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && q.all_animations_finished && q.is_using_item"
            }
          ],
          "on_entry": ["@s awp:normal"]
        },
        "setup": {
          "transitions": [
            {
              "awp.30": "query.get_equipped_item_name=='awp' && query.is_using_item && query.scoreboard('awp') >= 1 && q.mark_variant != 2"
            },
            {
              "awp.31": "query.get_equipped_item_name=='awp' && query.is_using_item && query.scoreboard('awp') == 0"
            }
          ],
          "on_entry": ["/function awp"]
        },
        "awp.31": {
          "animations": ["awpshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={awp=0}] slot.weapon.mainhand 1 krep:awp_emp 1 0"]
        },
        "awp.30": {
          "animations": ["awpshoot"],
          "transitions": [
            {
              "bolt": "query.all_animations_finished && query.get_equipped_item_name=='awp' && q.mark_variant!= 2"
            },
            {"setup": "query.get_equipped_item_name!='awp'"},
            {"setup": "query.get_equipped_item_name=='awp' && q.mark_variant == 2"}
          ],
          "on_entry": [
            "@s krep:awp_fire",
            "/scoreboard players remove @s[scores={awp=1..6}] awp 1",
            "/scoreboard players set @s[scores={awp=7..}] awp 6",
            "/playsound awp.shoot @a[r=30]",
            "/replaceitem entity @s[scores={awp=0}] slot.weapon.mainhand 1 krep:awp_emp 1 0",
            "/title @s[scores={awp=0}] actionbar No Ammunition"
          ]
        },
        "bolt": {
          "animations": ["awpbolt"],
          "transitions": [
            {"jawir": "query.all_animations_finished"},
            {"jawir": "query.get_equipped_item_name!='awp'"}
          ],
          "on_entry": ["@s awp:bolt", "/function awp"]
        }
      }
    },
    "controller.animation.awp.scope": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:normal"],
          "transitions": [
            {
              "scope.elcan": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='elcan' && q.property('krep:ammoreload')!=1"
            },
            {
              "scope.acog": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='acog' && q.property('krep:ammoreload')!=1"
            },
            {
              "scope.standard_8": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='standard_8' && q.property('krep:ammoreload')!=1"
            }
          ]
        },
        "scope.elcan": {
          "on_entry": ["@s krep:scope4x"],
          "transitions": [
            {
              "setup": "!query.is_sneaking || (query.get_equipped_item_name!='awp' && query.get_equipped_item_name!='awp_emp') || q.mark_variant == 2 || q.mark_variant == 1 || q.property('krep:ammoreload')==1 || q.property('krep:awpscope')=='coyote' || q.property('krep:awpscope')=='nothing'"
            },
            {
              "scope.acog": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='acog'"
            },
            {
              "scope.standard_8": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='standard_8'"
            }
          ]
        },
        "scope.acog": {
          "on_entry": ["@s krep:scope4x"],
          "transitions": [
            {
              "setup": "!query.is_sneaking || (query.get_equipped_item_name!='awp' && query.get_equipped_item_name!='awp_emp') || q.mark_variant == 2 || q.mark_variant == 1 || q.property('krep:ammoreload')==1 || q.property('krep:awpscope')=='coyote' || q.property('krep:awpscope')=='nothing'"
            },
            {
              "scope.elcan": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='elcan'"
            },
            {
              "scope.standard_8": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='standard_8'"
            }
          ]
        },
        "scope.standard_8": {
          "on_entry": ["@s krep:scope8x"],
          "transitions": [
            {
              "setup": "!query.is_sneaking || (query.get_equipped_item_name!='awp' && query.get_equipped_item_name!='awp_emp') || q.mark_variant == 2 || q.mark_variant == 1 || q.property('krep:ammoreload')==1 || q.property('krep:awpscope')=='coyote' || q.property('krep:awpscope')=='nothing'"
            },
            {
              "scope.acog": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='acog'"
            },
            {
              "scope.elcan": "(query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:awpscope')=='elcan'"
            }
          ]
        }
      }
    },
    "controller.animation.awp.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='awp_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='awp' && variable.attack_time > 0.0f && query.scoreboard('awp') <= 4 && q.mark_variant != 3 && q.property('krep:ammoreload')!=1) || (q.mark_variant == 2 && query.get_equipped_item_name=='awp' && q.property('krep:ammoreload')!=1)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function awpquantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='awp' && q.property('krep:ammoreload') == 340"},
            {
              "reload.tac": "query.get_equipped_item_name=='awp' && q.property('krep:ammoreload') >= 341"
            },
            {"setup": "query.get_equipped_item_name!='awp'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function awpquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='awp_emp' && q.property('krep:ammoreload') == 340"
            },
            {
              "reload": "query.get_equipped_item_name=='awp_emp' && q.property('krep:ammoreload') >= 341"
            },
            {"setup": "query.get_equipped_item_name!='awp'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "awpreload": "query.get_equipped_item_name('main_hand')=='awp_emp' || query.get_equipped_item_name('main_hand')=='awp'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='awp_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "awpreloadtac": "query.get_equipped_item_name('main_hand')=='awp_emp' || query.get_equipped_item_name('main_hand')=='awp'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='awp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function awp", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='awp' || query.get_equipped_item_name=='awp_emp'"
            }
          ]
        }
      }
    }
  }
}
