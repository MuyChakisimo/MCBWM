{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m9a4": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m9a4' && q.is_using_item) || query.get_equipped_item_name=='m9a4_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m9a4 17",
            "/event entity @s[hasitem={item=krep:m9a4, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m9a4.13": "query.get_equipped_item_name=='m9a4' && query.is_using_item && query.scoreboard('m9a4') >= 1 && q.mark_variant != 2"
            }
          ],
          "on_entry": ["/function m9a4"]
        },
        "m9a4.13": {
          "animations": ["m9a4shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:m9a4_fire",
            "/scoreboard players remove @s[scores={m9a4=1..18}] m9a4 1",
            "/playsound m9a4.shoot @a[r=30]",
            "/replaceitem entity @s[scores={m9a4=0}] slot.weapon.mainhand 1 krep:m9a4_emp 1 0",
            "/title @s[scores={m9a4=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.m9a4.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m9a4_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m9a4' && variable.attack_time > 0.0f && query.scoreboard('m9a4') <= 16) || (query.get_equipped_item_name=='m9a4' && q.mark_variant == 2)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m9a4quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m9a4' && q.property('krep:ammoreload') == 0"},
            {
              "reload.tac": "query.get_equipped_item_name=='m9a4' && q.property('krep:ammoreload') >= 1"
            },
            {"setup": "query.get_equipped_item_name!='m9a4'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m9a4quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m9a4_emp' && q.property('krep:ammoreload') == 0"
            },
            {
              "reload": "query.get_equipped_item_name=='m9a4_emp' && q.property('krep:ammoreload') >= 1"
            },
            {"setup": "query.get_equipped_item_name!='m9a4'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m9a4reload": "query.get_equipped_item_name('main_hand')=='m9a4_emp' || query.get_equipped_item_name('main_hand')=='m9a4'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m9a4_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m9a4reloadtac": "query.get_equipped_item_name('main_hand')=='m9a4_emp' || query.get_equipped_item_name('main_hand')=='m9a4'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m9a4'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m9a4"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m9a4' || query.get_equipped_item_name=='m9a4_emp'"
            }
          ]
        }
      }
    }
  }
}
