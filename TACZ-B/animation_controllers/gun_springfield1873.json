{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.springfield1873": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='springfield1873' && q.is_using_item) || query.get_equipped_item_name=='springfield1873_emp'"
            }
          ],
          "on_entry": [
            "/event entity @s[hasitem={item=krep:springfield1873, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {"transitions": [], "on_entry": []},
        "springfield1873.31": {
          "animations": ["springfield1873shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s slot.weapon.mainhand 1 krep:springfield1873_emp 1 0"]
        }
      }
    }
  }
}
