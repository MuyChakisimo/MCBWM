{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.sks": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='sks' && q.is_using_item) || query.get_equipped_item_name=='sks_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s sks 10",
            "/event entity @s[hasitem={item=krep:sks, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "sks.30": "query.get_equipped_item_name=='sks' && query.is_using_item && query.scoreboard('sks') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')==0"
            },
            {
              "skss.30": "query.get_equipped_item_name=='sks' && query.is_using_item && query.scoreboard('sks') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')>=1"
            },
            {
              "sks.31": "query.get_equipped_item_name=='sks' && query.is_using_item && query.scoreboard('sks') == 0"
            }
          ],
          "on_entry": ["/function sks"]
        },
        "sks.31": {
          "animations": ["sksshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={sks=0}] slot.weapon.mainhand 1 krep:sks_emp 1 0"]
        },
        "sks.30": {
          "animations": ["sksshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:sks_fire",
            "/scoreboard players remove @s[scores={sks=1..11}] sks 1",
            "/scoreboard players set @s[scores={sks=12..}] sks 11",
            "/playsound sks.shoot @a[r=30]",
            "/replaceitem entity @s[scores={sks=0}] slot.weapon.mainhand 1 krep:sks_emp 1 0",
            "/title @s[scores={sks=0}] actionbar No Ammunition"
          ]
        },
        "skss.30": {
          "animations": ["sksshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:sks_fire",
            "/scoreboard players remove @s[scores={sks=1..11}] sks 1",
            "/scoreboard players set @s[scores={sks=12..}] sks 11",
            "/playsound sks.suppress @a[r=15]",
            "/replaceitem entity @s[scores={sks=0}] slot.weapon.mainhand 1 krep:sks_emp 1 0",
            "/title @s[scores={sks=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.sks.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='sks_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='sks' && variable.attack_time > 0.0f && query.scoreboard('sks') <= 8 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='sks')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function sksquantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='sks' && q.property('krep:ammoreload') == 40"},
            {
              "reload.tac": "query.get_equipped_item_name=='sks' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='sks'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function sksquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='sks_emp' && q.property('krep:ammoreload') == 40"
            },
            {
              "reload": "query.get_equipped_item_name=='sks_emp' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='sks'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "sksreload": "query.get_equipped_item_name('main_hand')=='sks_emp' || query.get_equipped_item_name('main_hand')=='sks'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='sks_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "sksreloadtac": "query.get_equipped_item_name('main_hand')=='sks_emp' || query.get_equipped_item_name('main_hand')=='sks'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='sks'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function sks"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='sks' || query.get_equipped_item_name=='sks_emp'"
            }
          ]
        }
      }
    }
  }
}
