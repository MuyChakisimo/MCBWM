{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.sks": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='sks' && q.is_using_item) || query.get_equipped_item_name=='sks_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s sks 10",
            "/event entity @s[hasitem={item=krep:sks, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "sks.31": "query.get_equipped_item_name=='sks' && query.is_using_item && query.scoreboard('sks') == 0"
            }
          ],
          "on_entry": ["/function sks"]
        },
        "sks.31": {
          "animations": ["sksshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={sks=0}] slot.weapon.mainhand 1 krep:sks_emp 1 0"]
        }
      }
    }
  }
}
