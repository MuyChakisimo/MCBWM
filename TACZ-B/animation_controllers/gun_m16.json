{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m16": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m16' && q.is_using_item) || query.get_equipped_item_name=='m16_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m16 30",
            "/event entity @s[hasitem={item=krep:m16, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m16.31": "query.get_equipped_item_name=='m16' && query.is_using_item && query.scoreboard('m16') == 0"
            }
          ],
          "on_entry": ["/function m16"]
        },
        "m16.31": {
          "animations": ["m16shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m16=0}] slot.weapon.mainhand 1 krep:m16_emp 1 0"]
        }
      }
    }
  }
}
