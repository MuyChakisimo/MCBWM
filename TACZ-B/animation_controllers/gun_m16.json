{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m16": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m16' && q.is_using_item) || query.get_equipped_item_name=='m16_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m16 30",
            "/event entity @s[hasitem={item=krep:m16, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m16.30": "query.get_equipped_item_name=='m16' && query.is_using_item && query.scoreboard('m16') >= 1 && q.mark_variant != 2"
            },
            {
              "m16.31": "query.get_equipped_item_name=='m16' && query.is_using_item && query.scoreboard('m16') == 0"
            }
          ],
          "on_entry": ["/function m16"]
        },
        "m16.31": {
          "animations": ["m16shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m16=0}] slot.weapon.mainhand 1 krep:m16_emp 1 0"]
        },
        "m16.30": {
          "animations": ["m16shoot"],
          "transitions": [
            {"setup": "query.scoreboard('m16') == 0"},
            {
              "delay.30": "query.get_equipped_item_name=='m16' && query.scoreboard('m16') >= 1 && q.mark_variant != 2 && query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:m16_fire",
            "/function m16",
            "/scoreboard players set @s[scores={m16=32..}] m16 31",
            "/scoreboard players remove @s[scores={m16=1..31}] m16 1",
            "/playsound m16a1.shoot @a[r=30]",
            "/replaceitem entity @s[scores={m16=0}] slot.weapon.mainhand 1 krep:m16_emp 1 0",
            "/title @s[scores={m16=0}] actionbar No Ammunition"
          ]
        },
        "delay.30": {
          "animations": ["m16shoot"],
          "transitions": [
            {"setup": "query.scoreboard('m16') == 0"},
            {
              "m16.29": "query.get_equipped_item_name=='m16' && query.scoreboard('m16') >= 1 && q.mark_variant != 2 && query.all_animations_finished"
            }
          ]
        },
        "m16.29": {
          "animations": ["m16shoot"],
          "transitions": [
            {"setup": "query.scoreboard('m16') == 0"},
            {
              "delay.29": "query.get_equipped_item_name=='m16' && query.scoreboard('m16') >= 1 && q.mark_variant != 2 && query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:m16_fire",
            "/function m16",
            "/scoreboard players set @s[scores={m16=32..}] m16 31",
            "/scoreboard players remove @s[scores={m16=1..31}] m16 1",
            "/playsound m16a1.shoot @a[r=30]",
            "/replaceitem entity @s[scores={m16=0}] slot.weapon.mainhand 1 krep:m16_emp 1 0",
            "/title @s[scores={m16=0}] actionbar No Ammunition"
          ]
        },
        "delay.29": {
          "animations": ["m16shoot"],
          "transitions": [
            {"setup": "query.scoreboard('m16') == 0"},
            {
              "m16.28": "query.get_equipped_item_name=='m16' && query.scoreboard('m16') >= 1 && q.mark_variant != 2 && query.all_animations_finished"
            }
          ]
        },
        "m16.28": {
          "animations": ["m16shoot"],
          "transitions": [
            {"setup": "query.scoreboard('m16') == 0"},
            {
              "setup": "query.get_equipped_item_name=='m16' && query.scoreboard('m16') >= 1 && q.mark_variant != 2 && query.all_animations_finished && !q.is_using_item"
            }
          ],
          "on_entry": [
            "@s krep:m16_fire",
            "/function m16",
            "/scoreboard players set @s[scores={m16=32..}] m16 31",
            "/scoreboard players remove @s[scores={m16=1..31}] m16 1",
            "/playsound m16a1.shoot @a[r=30]",
            "/replaceitem entity @s[scores={m16=0}] slot.weapon.mainhand 1 krep:m16_emp 1 0",
            "/title @s[scores={m16=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.m16.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m16_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m16' && variable.attack_time > 0.0f && query.scoreboard('m16') <= 28 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='m16')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m16quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m16' && q.property('krep:ammoreload') == 250"},
            {
              "reload.tac": "query.get_equipped_item_name=='m16' && q.property('krep:ammoreload') >= 251"
            },
            {"setup": "query.get_equipped_item_name!='m16'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m16quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m16_emp' && q.property('krep:ammoreload') == 250"
            },
            {
              "reload": "query.get_equipped_item_name=='m16_emp' && q.property('krep:ammoreload') >= 251"
            },
            {"setup": "query.get_equipped_item_name!='m16'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m16reload": "query.get_equipped_item_name('main_hand')=='m16_emp' || query.get_equipped_item_name('main_hand')=='m16'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m16_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m16reloadtac": "query.get_equipped_item_name('main_hand')=='m16_emp' || query.get_equipped_item_name('main_hand')=='m16'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m16'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m16"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m16' || query.get_equipped_item_name=='m16_emp'"
            }
          ]
        }
      }
    }
  }
}
