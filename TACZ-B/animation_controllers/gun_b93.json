{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.b93": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='b93' && q.is_using_item) || query.get_equipped_item_name=='b93_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s b93 20",
            "/event entity @s[hasitem={item=krep:b93, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "b93.30": "query.get_equipped_item_name=='b93' && query.is_using_item && query.scoreboard('b93') >= 1 && q.mark_variant != 2"
            },
            {
              "b93.31": "query.get_equipped_item_name=='b93' && query.is_using_item && query.scoreboard('b93') == 0"
            }
          ],
          "on_entry": ["/function b93"]
        },
        "b93.31": {
          "animations": ["b93shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={b93=0}] slot.weapon.mainhand 1 krep:b93_emp 1 0"]
        },
        "b93.30": {
          "animations": ["b93shoot"],
          "transitions": [
            {"setup": "query.scoreboard('b93') == 0"},
            {
              "b93.29": "query.get_equipped_item_name=='b93' && query.scoreboard('b93') >= 1 && q.mark_variant != 2"
            }
          ],
          "on_entry": [
            "@s krep:b93_fire",
            "/scoreboard players set @s[scores={b93=22..}] b93 21",
            "/scoreboard players remove @s[scores={b93=1..21}] b93 1",
            "/playsound b93.shoot @a[r=30]",
            "/function b93",
            "/replaceitem entity @s[scores={b93=0}] slot.weapon.mainhand 1 krep:b93_emp 1 0",
            "/title @s[scores={b93=0}] actionbar No Ammunition"
          ]
        },
        "b93.29": {
          "animations": ["b93shoot"],
          "transitions": [
            {"setup": "query.scoreboard('b93') == 0"},
            {
              "b93.28": "query.get_equipped_item_name=='b93' && query.scoreboard('b93') >= 1 && q.mark_variant != 2"
            }
          ],
          "on_entry": [
            "@s krep:b93_fire",
            "/scoreboard players set @s[scores={b93=22..}] b93 21",
            "/scoreboard players remove @s[scores={b93=1..21}] b93 1",
            "/playsound b93.shoot @a[r=30]",
            "/function b93",
            "/replaceitem entity @s[scores={b93=0}] slot.weapon.mainhand 1 krep:b93_emp 1 0",
            "/title @s[scores={b93=0}] actionbar No Ammunition"
          ]
        },
        "b93.28": {
          "animations": ["b93shoot"],
          "transitions": [
            {"setup": "query.scoreboard('b93') == 0"},
            {"setup": "!q.is_using_item && q.all_animations_finished"}
          ],
          "on_entry": [
            "@s krep:b93_fire",
            "/scoreboard players set @s[scores={b93=22..}] b93 21",
            "/scoreboard players remove @s[scores={b93=1..21}] b93 1",
            "/playsound b93.shoot @a[r=30]",
            "/function b93",
            "/replaceitem entity @s[scores={b93=0}] slot.weapon.mainhand 1 krep:b93_emp 1 0",
            "/title @s[scores={b93=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.b93.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='b93_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='b93' && variable.attack_time > 0.0f && query.scoreboard('b93') <= 18 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='b93')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function b93quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='b93' && q.property('krep:ammoreload') == 40"},
            {
              "reload.tac": "query.get_equipped_item_name=='b93' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='b93'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function b93quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='b93_emp' && q.property('krep:ammoreload') == 40"
            },
            {
              "reload": "query.get_equipped_item_name=='b93_emp' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='b93'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "b93reload": "query.get_equipped_item_name('main_hand')=='b93_emp' || query.get_equipped_item_name('main_hand')=='b93'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='b93_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "b93reloadtac": "query.get_equipped_item_name('main_hand')=='b93_emp' || query.get_equipped_item_name('main_hand')=='b93'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='b93'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function b93"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='b93' || query.get_equipped_item_name=='b93_emp'"
            }
          ]
        }
      }
    }
  }
}
