{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.p320": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='p320' && q.is_using_item) || query.get_equipped_item_name=='p320_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s p320 12",
            "/event entity @s[hasitem={item=krep:p320, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {"transitions": [], "on_entry": ["/function p320"]}
      }
    }
  }
}
