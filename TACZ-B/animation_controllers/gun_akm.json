{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.akm": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='akm' && q.is_using_item) || query.get_equipped_item_name=='akm_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s akm 30",
            "/event entity @s[hasitem={item=krep:akm, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "akm.31": "query.get_equipped_item_name=='akm' && query.is_using_item && query.scoreboard('akm') == 0"
            }
          ],
          "on_entry": ["/function akm"]
        },
        "akm.31": {
          "animations": ["akmshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={akm=0}] slot.weapon.mainhand 1 krep:akm_emp 1 0"]
        }
      }
    }
  }
}
