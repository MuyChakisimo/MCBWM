{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.spr15": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='spr15' && q.is_using_item) || query.get_equipped_item_name=='spr15_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s spr15 15",
            "/event entity @s[hasitem={item=krep:spr15, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "spr15.31": "query.get_equipped_item_name=='spr15' && query.is_using_item && query.scoreboard('spr15') == 0"
            }
          ],
          "on_entry": ["/function spr15"]
        },
        "spr15.31": {
          "animations": ["spr15shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={spr15=0}] slot.weapon.mainhand 1 krep:spr15_emp 1 0"]
        }
      }
    },
    "controller.animation.spr15.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='spr15_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='spr15' && variable.attack_time > 0.0f && query.scoreboard('spr15') <= 28 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='spr15')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function spr15quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='spr15' && q.property('krep:ammoreload') == 460"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='spr15' && q.property('krep:ammoreload') >= 461"
            },
            {"setup": "query.get_equipped_item_name!='spr15'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function spr15quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='spr15_emp' && q.property('krep:ammoreload') == 460"
            },
            {
              "reload": "query.get_equipped_item_name=='spr15_emp' && q.property('krep:ammoreload') >= 461"
            },
            {"setup": "query.get_equipped_item_name!='spr15'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "spr15reload": "query.get_equipped_item_name('main_hand')=='spr15_emp' || query.get_equipped_item_name('main_hand')=='spr15'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='spr15_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "spr15reloadtac": "query.get_equipped_item_name('main_hand')=='spr15_emp' || query.get_equipped_item_name('main_hand')=='spr15'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='spr15'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function spr15"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='spr15' || query.get_equipped_item_name=='spr15_emp'"
            }
          ]
        }
      }
    }
  }
}
