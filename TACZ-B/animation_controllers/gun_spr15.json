{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.spr15": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='spr15' && q.is_using_item) || query.get_equipped_item_name=='spr15_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s spr15 15",
            "/event entity @s[hasitem={item=krep:spr15, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "spr15.31": "query.get_equipped_item_name=='spr15' && query.is_using_item && query.scoreboard('spr15') == 0"
            }
          ],
          "on_entry": ["/function spr15"]
        },
        "spr15.31": {
          "animations": ["spr15shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={spr15=0}] slot.weapon.mainhand 1 krep:spr15_emp 1 0"]
        }
      }
    }
  }
}
