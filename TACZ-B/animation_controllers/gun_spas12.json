{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.spas12": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='spas12' && q.is_using_item) || query.get_equipped_item_name=='spas12_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s spas12 5",
            "/event entity @s[hasitem={item=krep:spas12, location=slot.weapon.mainhand}] krep:noreload",
            "@s spas12:normal"
          ]
        },
        "setup": {
          "transitions": [
            {
              "spas12.31": "query.get_equipped_item_name=='spas12' && query.is_using_item && query.scoreboard('spas12') == 0"
            }
          ],
          "on_entry": ["/function spas12"]
        },
        "spas12.31": {
          "animations": ["spas12shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={spas12=0}] slot.weapon.mainhand 1 krep:spas12_emp 1 0"]
        }
      }
    }
  }
}
