{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dblong": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='dblong' && q.is_using_item) || query.get_equipped_item_name=='dblong_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s dblong 2",
            "/event entity @s[hasitem={item=krep:dblong, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "dblong.30": "query.get_equipped_item_name=='dblong' && query.is_using_item && query.scoreboard('dblong') >= 1 && q.mark_variant != 2"
            },
            {
              "dblong.31": "query.get_equipped_item_name=='dblong' && query.is_using_item && query.scoreboard('dblong') == 0"
            }
          ],
          "on_entry": ["/function dblong"]
        },
        "dblong.31": {
          "animations": ["dblongshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={dblong=0}] slot.weapon.mainhand 1 krep:dblong_emp 1 0"]
        },
        "dblong.30": {
          "animations": ["dblongshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:dblong_fire",
            "/scoreboard players set @s[scores={dblong=3..}] dblong 2",
            "/scoreboard players remove @s[scores={dblong=1..}] dblong 1",
            "/playsound dblong.shoot @a[r=30]",
            "/replaceitem entity @s[scores={dblong=0}] slot.weapon.mainhand 1 krep:dblong_emp 1 0",
            "/title @s[scores={dblong=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.dblong.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='dblong_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='dblong' && variable.attack_time > 0.0f && query.scoreboard('dblong') <= 18 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='dblong')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function dblongquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='dblong' && q.property('krep:ammoreload') == 640"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='dblong' && q.property('krep:ammoreload') >= 641"
            },
            {"setup": "query.get_equipped_item_name!='dblong'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function dblongquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='dblong_emp' && q.property('krep:ammoreload') == 640"
            },
            {
              "reload": "query.get_equipped_item_name=='dblong_emp' && q.property('krep:ammoreload') >= 642"
            },
            {
              "reload1": "query.get_equipped_item_name=='dblong_emp' && q.property('krep:ammoreload') == 641"
            },
            {"setup": "query.get_equipped_item_name!='dblong'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "dblongreload": "query.get_equipped_item_name('main_hand')=='dblong_emp' || query.get_equipped_item_name('main_hand')=='dblong'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='dblong_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload1": {
          "animations": [
            {
              "dblongreload1": "query.get_equipped_item_name('main_hand')=='dblong_emp' || query.get_equipped_item_name('main_hand')=='dblong'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='dblong_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "dblongreloadtac": "query.get_equipped_item_name('main_hand')=='dblong_emp' || query.get_equipped_item_name('main_hand')=='dblong'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='dblong'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function dblong"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='dblong' || query.get_equipped_item_name=='dblong_emp'"
            }
          ]
        }
      }
    }
  }
}
