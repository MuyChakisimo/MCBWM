{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dblong": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='dblong' && q.is_using_item) || query.get_equipped_item_name=='dblong_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s dblong 2",
            "/event entity @s[hasitem={item=krep:dblong, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "dblong.31": "query.get_equipped_item_name=='dblong' && query.is_using_item && query.scoreboard('dblong') == 0"
            }
          ],
          "on_entry": ["/function dblong"]
        },
        "dblong.31": {
          "animations": ["dblongshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={dblong=0}] slot.weapon.mainhand 1 krep:dblong_emp 1 0"]
        }
      }
    }
  }
}
