{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m4a1.scope": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:normal"],
          "transitions": [
            {
              "scope.elcan": "(query.get_equipped_item_name=='m4a1' || query.get_equipped_item_name=='m4a1_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:m4a1scope')=='elcan' && q.property('krep:ammoreload')!=1"
            },
            {
              "scope.acog": "(query.get_equipped_item_name=='m4a1' || query.get_equipped_item_name=='m4a1_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:m4a1scope')=='acog' && q.property('krep:ammoreload')!=1"
            }
          ]
        },
        "scope.elcan": {
          "on_entry": ["@s krep:scope4x"],
          "transitions": [
            {
              "setup": "!query.is_sneaking || (query.get_equipped_item_name!='m4a1' && query.get_equipped_item_name!='m4a1_emp') || q.mark_variant == 2 || q.mark_variant == 1 || q.property('krep:ammoreload')==1 || (q.property('krep:m4a1scope')!='acog' && q.property('krep:m4a1scope')!='elcan')"
            },
            {
              "scope.acog": "(query.get_equipped_item_name=='m4a1' || query.get_equipped_item_name=='m4a1_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:m4a1scope')=='acog'"
            }
          ]
        },
        "scope.acog": {
          "on_entry": ["@s krep:scope4x"],
          "transitions": [
            {
              "setup": "!query.is_sneaking || (query.get_equipped_item_name!='m4a1' && query.get_equipped_item_name!='m4a1_emp') || q.mark_variant == 2 || q.mark_variant == 1 || q.property('krep:ammoreload')==1 || (q.property('krep:m4a1scope')!='acog' && q.property('krep:m4a1scope')!='elcan')"
            },
            {
              "scope.elcan": "(query.get_equipped_item_name=='m4a1' || query.get_equipped_item_name=='m4a1_emp') && query.is_sneaking && q.mark_variant != 2 && q.mark_variant != 1 && q.property('krep:m4a1scope')=='elcan'"
            }
          ]
        }
      }
    },
    "controller.animation.m4a1": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m4a1' && q.is_using_item) || query.get_equipped_item_name=='m4a1_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m4a1 30",
            "@s[hasitem={item=krep:m4a1, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m4a1.30": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2  && q.property('krep:muzzle') <= 3"
            },
            {
              "m4a1.30s": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle') >= 4"
            },
            {
              "m4a1.31": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') == 0"
            }
          ],
          "on_entry": ["/function m4a1", "/scoreboard players set @s m4a1sound 0"]
        },
        "m4a1.31": {
          "animations": ["m4a1shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m4a1=0}] slot.weapon.mainhand 1 krep:m4a1_emp 1 0"]
        },
        "m4a1.30": {
          "animations": ["m4a1shoot"],
          "transitions": [
            {
              "delay.30": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {"setup": "q.mark_variant == 2"},
            {"setup": "query.get_equipped_item_name!='m4a1'"},
            {"setup": "query.get_equipped_item_name=='m4a1' && !query.is_using_item"},
            {"setup": "q.property('krep:muzzle') > 3"},
            {"setup": "query.scoreboard('m4a1') == 0"}
          ],
          "on_entry": [
            "@s krep:m4a1_fire",
            "/function m4a1",
            "/playsound m4a1.shoot @a[r=30]",
            "/scoreboard players set @s[scores={m4a1=32..}] m4a1 31",
            "/scoreboard players add @s[scores={m4a1sound=0}] m4a1sound 1",
            "/scoreboard players remove @s[scores={m4a1=1..31}] m4a1 1",
            "/replaceitem entity @s[scores={m4a1=0}] slot.weapon.mainhand 1 krep:m4a1_emp 1 0",
            "/title @s[scores={m4a1=0}] actionbar No Ammunition"
          ]
        },
        "delay.30": {
          "animations": ["m4a1shoot"],
          "transitions": [
            {
              "m4a1.29": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {"setup": "query.scoreboard('m4a1') == 0"}
          ]
        },
        "m4a1.29": {
          "transitions": [
            {
              "m4a1.30": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2"
            },
            {"setup": "q.mark_variant == 2"},
            {"setup": "query.get_equipped_item_name!='m4a1'"},
            {"setup": "q.property('krep:muzzle') > 3"},
            {"setup": "query.get_equipped_item_name=='m4a1' && !query.is_using_item"},
            {"setup": "query.scoreboard('m4a1') == 0"}
          ],
          "on_entry": [
            "@s krep:m4a1_fire",
            "/function m4a1",
            "/playsound m4a1.shoot @a[r=30]",
            "/scoreboard players set @s[scores={m4a1=32..}] m4a1 31",
            "/scoreboard players add @s[scores={m4a1sound=0}] m4a1sound 1",
            "/scoreboard players remove @s[scores={m4a1=1..31}] m4a1 1",
            "/replaceitem entity @s[scores={m4a1=0}] slot.weapon.mainhand 1 krep:m4a1_emp 1 0",
            "/title @s[scores={m4a1=0}] actionbar No Ammunition"
          ]
        },
        "m4a1.30s": {
          "animations": ["m4a1shoot"],
          "transitions": [
            {
              "delay.30s": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {"setup": "q.mark_variant == 2"},
            {"setup": "query.get_equipped_item_name!='m4a1'"},
            {"setup": "q.property('krep:muzzle') < 4"},
            {"setup": "query.get_equipped_item_name=='m4a1' && !query.is_using_item"},
            {"setup": "query.scoreboard('m4a1') == 0"}
          ],
          "on_entry": [
            "@s krep:m4a1_fire",
            "/function m4a1",
            "/playsound m4a1.suppress @a[r=15]",
            "/scoreboard players set @s[scores={m4a1=32..}] m4a1 31",
            "/scoreboard players remove @s[scores={m4a1=1..31}] m4a1 1",
            "/scoreboard players add @s[scores={m4a1sound=0}] m4a1sound 1",
            "/replaceitem entity @s[scores={m4a1=0}] slot.weapon.mainhand 1 krep:m4a1_emp 1 0",
            "/title @s[scores={m4a1=0}] actionbar No Ammunition"
          ]
        },
        "delay.30s": {
          "animations": ["m4a1shoot"],
          "transitions": [
            {
              "m4a1.29s": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {"setup": "q.mark_variant == 2"},
            {"setup": "query.get_equipped_item_name!='m4a1'"},
            {"setup": "q.property('krep:muzzle') < 4"},
            {"setup": "query.get_equipped_item_name=='m4a1' && !query.is_using_item"},
            {"setup": "query.scoreboard('m4a1') == 0"}
          ]
        },
        "m4a1.29s": {
          "transitions": [
            {
              "m4a1.30s": "query.get_equipped_item_name=='m4a1' && query.is_using_item && query.scoreboard('m4a1') >= 1 && q.mark_variant != 2"
            },
            {"setup": "q.mark_variant == 2"},
            {"setup": "query.get_equipped_item_name!='m4a1'"},
            {"setup": "q.property('krep:muzzle') < 4"},
            {"setup": "query.get_equipped_item_name=='m4a1' && !query.is_using_item"},
            {"setup": "query.scoreboard('m4a1') == 0"}
          ],
          "on_entry": [
            "@s krep:m4a1_fire",
            "/function m4a1",
            "/playsound m4a1.suppress @a[r=15]",
            "/scoreboard players set @s[scores={m4a1=32..}] m4a1 31",
            "/scoreboard players add @s[scores={m4a1sound=0}] m4a1sound 1",
            "/scoreboard players remove @s[scores={m4a1=1..31}] m4a1 1",
            "/replaceitem entity @s[scores={m4a1=0}] slot.weapon.mainhand 1 krep:m4a1_emp 1 0",
            "/title @s[scores={m4a1=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.m4a1.inspect": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "transitions": [
            {
              "trigger.inspect": "(query.get_equipped_item_name=='m4a1' && variable.attack_time > 0.0f && query.scoreboard('m4a1') >= 30 && q.mark_variant != 2)"
            }
          ]
        },
        "trigger.inspect": {
          "animations": ["m4a1shoot"],
          "on_entry": ["@s krep:inspect"],
          "on_exit": ["@s krep:noinspect"],
          "transitions": [{"setup": "query.is_using_item || q.all_animations_finished || q.mark_variant == 2"}]
        }
      }
    },
    "controller.animation.m4a1.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m4a1_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m4a1' && variable.attack_time > 0.0f && query.scoreboard('m4a1') <= 28 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='m4a1')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m4a1quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m4a1' && q.property('krep:ammoreload') == 460"},
            {
              "reload.tac": "query.get_equipped_item_name=='m4a1' && q.property('krep:ammoreload') >= 461"
            },
            {"setup": "query.get_equipped_item_name!='m4a1'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m4a1quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m4a1_emp' && q.property('krep:ammoreload') == 460"
            },
            {
              "reload": "query.get_equipped_item_name=='m4a1_emp' && q.property('krep:ammoreload') >= 461"
            },
            {"setup": "query.get_equipped_item_name!='m4a1'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m4a1reload": "query.get_equipped_item_name('main_hand')=='m4a1_emp' || query.get_equipped_item_name('main_hand')=='m4a1'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m4a1_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m4a1reloadtac": "query.get_equipped_item_name('main_hand')=='m4a1_emp' || query.get_equipped_item_name('main_hand')=='m4a1'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m4a1'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m4a1"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m4a1' || query.get_equipped_item_name=='m4a1_emp'"
            }
          ]
        }
      }
    }
  }
}
