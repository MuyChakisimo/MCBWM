{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mp7": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='mp7' && q.is_using_item) || query.get_equipped_item_name=='mp7_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s mp7 40",
            "/event entity @s[hasitem={item=krep:mp7, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "mp7.31": "query.get_equipped_item_name=='mp7' && query.is_using_item && query.scoreboard('mp7') == 0"
            }
          ],
          "on_entry": ["/function mp7"]
        },
        "mp7.31": {
          "animations": ["mp7shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={mp7=0}] slot.weapon.mainhand 1 krep:mp7_emp 1 0"]
        }
      }
    },
    "controller.animation.mp7.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='mp7_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='mp7' && variable.attack_time > 0.0f && query.scoreboard('mp7') <= 38 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='mp7')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function mp7quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='mp7' && q.property('krep:ammoreload') == 550"},
            {
              "reload.tac": "query.get_equipped_item_name=='mp7' && q.property('krep:ammoreload') >= 551"
            },
            {"setup": "query.get_equipped_item_name!='mp7'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function mp7quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='mp7_emp' && q.property('krep:ammoreload') == 550"
            },
            {"setup": "query.get_equipped_item_name!='mp7_emp'"},
            {
              "reload": "query.get_equipped_item_name=='mp7_emp' && q.property('krep:ammoreload') >= 551"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "mp7reload": "query.get_equipped_item_name('main_hand')=='mp7_emp' || query.get_equipped_item_name('main_hand')=='mp7'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='mp7_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "mp7reloadtac": "query.get_equipped_item_name('main_hand')=='mp7_emp' || query.get_equipped_item_name('main_hand')=='mp7'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='mp7'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function mp7", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='mp7' || query.get_equipped_item_name=='mp7_emp'"
            }
          ]
        }
      }
    }
  }
}
