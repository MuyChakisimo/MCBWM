{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mp7": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='mp7' && q.is_using_item) || query.get_equipped_item_name=='mp7_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s mp7 40",
            "/event entity @s[hasitem={item=krep:mp7, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "mp7.31": "query.get_equipped_item_name=='mp7' && query.is_using_item && query.scoreboard('mp7') == 0"
            }
          ],
          "on_entry": ["/function mp7"]
        },
        "mp7.31": {
          "animations": ["mp7shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={mp7=0}] slot.weapon.mainhand 1 krep:mp7_emp 1 0"]
        }
      }
    }
  }
}
