{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.aa12": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='aa12' && q.is_using_item) || query.get_equipped_item_name=='aa12_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s aa12 10",
            "/event entity @s[hasitem={item=krep:aa12, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "aa12.31": "query.get_equipped_item_name=='aa12' && query.is_using_item && query.scoreboard('aa12') == 0"
            }
          ],
          "on_entry": ["/function aa12"]
        },
        "aa12.31": {
          "animations": ["aa12shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={aa12=0}] slot.weapon.mainhand 1 krep:aa12_emp 1 0"]
        }
      }
    },
    "controller.animation.aa12.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='aa12_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='aa12' && variable.attack_time > 0.0f && query.scoreboard('aa12') <= 9 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='aa12')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function aa12quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='aa12' && q.property('krep:ammoreload') == 320"},
            {
              "reload.tac": "query.get_equipped_item_name=='aa12' && q.property('krep:ammoreload') >= 321"
            },
            {"setup": "query.get_equipped_item_name!='aa12'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function aa12quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='aa12_emp' && q.property('krep:ammoreload') == 320"
            },
            {
              "reload": "query.get_equipped_item_name=='aa12_emp' && q.property('krep:ammoreload') >= 321"
            },
            {"setup": "query.get_equipped_item_name!='aa12'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "aa12reload": "query.get_equipped_item_name('main_hand')=='aa12_emp' || query.get_equipped_item_name('main_hand')=='aa12'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='aa12_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "aa12reloadtac": "query.get_equipped_item_name('main_hand')=='aa12_emp' || query.get_equipped_item_name('main_hand')=='aa12'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='aa12'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function aa12", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='aa12' || query.get_equipped_item_name=='aa12_emp'"
            }
          ]
        }
      }
    }
  }
}
