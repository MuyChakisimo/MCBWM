{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ump": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='ump' && q.is_using_item) || query.get_equipped_item_name=='ump_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s ump 25",
            "@s[hasitem={item=krep:ump, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "ump.30": "query.get_equipped_item_name=='ump' && query.is_using_item && query.scoreboard('ump') >= 1 && q.mark_variant != 2"
            },
            {
              "ump.31": "query.get_equipped_item_name=='ump' && query.is_using_item && query.scoreboard('ump') == 0"
            }
          ],
          "on_entry": ["/function ump"]
        },
        "ump.31": {
          "animations": ["umpshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={ump=0}] slot.weapon.mainhand 1 krep:ump_emp 1 0"]
        },
        "ump.30": {
          "animations": ["umpshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:ump_fire",
            "/scoreboard players set @s[scores={ump=27..}] ump 26",
            "/scoreboard players remove @s[scores={ump=1..26}] ump 1",
            "/playsound ump.shoot @a[r=30]",
            "/replaceitem entity @s[scores={ump=0}] slot.weapon.mainhand 1 krep:ump_emp 1 0",
            "/title @s[scores={ump=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.ump.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='ump_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='ump' && variable.attack_time > 0.0f && query.scoreboard('ump') <= 24 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='ump')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function umpquantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='ump' && q.property('krep:ammoreload') == 40"},
            {
              "reload.tac": "query.get_equipped_item_name=='ump' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='ump'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function umpquantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='ump_emp' && q.property('krep:ammoreload') == 40"
            },
            {
              "reload": "query.get_equipped_item_name=='ump_emp' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='ump'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "umpreload": "query.get_equipped_item_name('main_hand')=='ump_emp' || query.get_equipped_item_name('main_hand')=='ump'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='ump_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "umpreloadtac": "query.get_equipped_item_name('main_hand')=='ump_emp' || query.get_equipped_item_name('main_hand')=='ump'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='ump'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function ump"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='ump' || query.get_equipped_item_name=='ump_emp'"
            }
          ]
        }
      }
    }
  }
}
