{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.cz75": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='cz75' && q.is_using_item) || query.get_equipped_item_name=='cz75_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s cz75 16",
            "/event entity @s[hasitem={item=krep:cz75, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {"transitions": [], "on_entry": ["/function cz75"]}
      }
    }
  }
}
