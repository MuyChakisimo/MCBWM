{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m107": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m107' && q.is_using_item) || query.get_equipped_item_name=='m107_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m107 10",
            "@s[hasitem={item=krep:m107, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m107.30": "query.get_equipped_item_name=='m107' && query.is_using_item && query.scoreboard('m107') >= 1 && q.mark_variant != 2"
            },
            {
              "m107.31": "query.get_equipped_item_name=='m107' && query.is_using_item && query.scoreboard('m107') == 0"
            }
          ],
          "on_entry": ["/function m107"]
        },
        "m107.31": {
          "animations": ["m107shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m107=0}] slot.weapon.mainhand 1 krep:m107_emp 1 0"]
        },
        "m107.30": {
          "animations": ["m107shoot"],
          "transitions": [{"setup": "query.all_animations_finished && !q.is_using_item"}],
          "on_entry": [
            "@s krep:m107_fire",
            "/scoreboard players remove @s[scores={m107=1..11}] m107 1",
            "/scoreboard players set @s[scores={m107=12..}] m107 11",
            "/playsound m107.shoot @a[r=120]",
            "/replaceitem entity @s[scores={m107=0}] slot.weapon.mainhand 1 krep:m107_emp 1 0",
            "/title @s[scores={m107=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.m107.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m107_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m107' && variable.attack_time > 0.0f && query.scoreboard('m107') <= 9 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='m107')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m107quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m107' && q.property('krep:ammoreload') == 750"},
            {
              "reload.tac": "query.get_equipped_item_name=='m107' && q.property('krep:ammoreload') >= 751"
            },
            {"setup": "query.get_equipped_item_name!='m107'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m107quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m107_emp' && q.property('krep:ammoreload') == 750"
            },
            {
              "reload": "query.get_equipped_item_name=='m107_emp' && q.property('krep:ammoreload') >= 751"
            },
            {"setup": "query.get_equipped_item_name!='m107'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m107reload": "query.get_equipped_item_name('main_hand')=='m107_emp' || query.get_equipped_item_name('main_hand')=='m107'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m107_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m107reloadtac": "query.get_equipped_item_name('main_hand')=='m107_emp' || query.get_equipped_item_name('main_hand')=='m107'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m107'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m107", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m107' || query.get_equipped_item_name=='m107_emp'"
            }
          ]
        }
      }
    }
  }
}
