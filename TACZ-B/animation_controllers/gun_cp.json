{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.cp.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='cp_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='cp' && variable.attack_time > 0.0f && query.scoreboard('cp') <= 5) || (query.get_equipped_item_name=='cp' && q.mark_variant == 2)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function cpquantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='cp' && q.property('krep:ammoreload') == 0"},
            {
              "reload.tac": "query.get_equipped_item_name=='cp' && q.property('krep:ammoreload') >= 1"
            },
            {"setup": "query.get_equipped_item_name!='cp'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function cpquantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='cp_emp' && q.property('krep:ammoreload') == 0"},
            {
              "reload": "query.get_equipped_item_name=='cp_emp' && q.property('krep:ammoreload') >= 1"
            },
            {"setup": "query.get_equipped_item_name!='cp'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "cpreload": "query.get_equipped_item_name('main_hand')=='cp_emp' || query.get_equipped_item_name('main_hand')=='cp'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='cp_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "cpreloadtac": "query.get_equipped_item_name('main_hand')=='cp_emp' || query.get_equipped_item_name('main_hand')=='cp'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='cp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function cp"],
          "transitions": [{"setup": "query.get_equipped_item_name=='cp' || query.get_equipped_item_name=='cp_emp'"}]
        }
      }
    },
    "controller.animation.cp": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='cp' && q.is_using_item) || query.get_equipped_item_name=='cp_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s cp 6",
            "/event entity @s[hasitem={item=krep:cp, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "cp.30": "query.get_equipped_item_name=='cp' && query.is_using_item && query.scoreboard('cp') >= 1 && q.mark_variant != 2"
            },
            {
              "cp.31": "query.get_equipped_item_name=='cp' && query.is_using_item && query.scoreboard('cp') == 0"
            }
          ],
          "on_entry": ["/function cp"]
        },
        "cp.31": {
          "animations": ["cpshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={cp=0}] slot.weapon.mainhand 1 krep:cp_emp 1 0"]
        },
        "cp.30": {
          "animations": ["cpshoot"],
          "transitions": [{"setup": "query.all_animations_finished && !q.is_using_item"}],
          "on_entry": [
            "@s krep:cp_fire",
            "/scoreboard players remove @s[scores={cp=1..7}] cp 1",
            "/scoreboard players set @s[scores={cp=7..}] cp 6",
            "/playsound cp.shoot @a[r=30]",
            "/replaceitem entity @s[scores={cp=0}] slot.weapon.mainhand 1 krep:cp_emp 1 0",
            "/title @s[scores={cp=0}] actionbar No Ammunition"
          ]
        }
      }
    }
  }
}
