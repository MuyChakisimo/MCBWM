{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m16a1": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m16a1' && q.is_using_item) || query.get_equipped_item_name=='m16a1_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m16a1 20",
            "/event entity @s[hasitem={item=krep:m16a1, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m16a1.30": "query.get_equipped_item_name=='m16a1' && query.is_using_item && query.scoreboard('m16a1') >= 1 && q.mark_variant != 2"
            },
            {
              "m16a1.31": "query.get_equipped_item_name=='m16a1' && query.is_using_item && query.scoreboard('m16a1') == 0"
            }
          ],
          "on_entry": ["/function m16a1"]
        },
        "m16a1.31": {
          "animations": ["m16a1shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m16a1=0}] slot.weapon.mainhand 1 krep:m16a1_emp 1 0"]
        },
        "m16a1.30": {
          "animations": ["m16a1shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:m16a1_fire",
            "/scoreboard players set @s[scores={m16a1=22..}] m16a1 21",
            "/scoreboard players remove @s[scores={m16a1=1..21}] m16a1 1",
            "/playsound m16a1.shoot @a[r=30]",
            "/replaceitem entity @s[scores={m16a1=0}] slot.weapon.mainhand 1 krep:m16a1_emp 1 0",
            "/title @s[scores={m16a1=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.m16a1.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m16a1_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m16a1' && variable.attack_time > 0.0f && query.scoreboard('m16a1') <= 18 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='m16a1')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m16a1quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m16a1' && q.property('krep:ammoreload') == 40"},
            {
              "reload.tac": "query.get_equipped_item_name=='m16a1' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='m16a1'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m16a1quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m16a1_emp' && q.property('krep:ammoreload') == 40"
            },
            {
              "reload": "query.get_equipped_item_name=='m16a1_emp' && q.property('krep:ammoreload') >= 41"
            },
            {"setup": "query.get_equipped_item_name!='m16a1'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m16a1reload": "query.get_equipped_item_name('main_hand')=='m16a1_emp' || query.get_equipped_item_name('main_hand')=='m16a1'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m16a1_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m16a1reloadtac": "query.get_equipped_item_name('main_hand')=='m16a1_emp' || query.get_equipped_item_name('main_hand')=='m16a1'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m16a1'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m16a1"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m16a1' || query.get_equipped_item_name=='m16a1_emp'"
            }
          ]
        }
      }
    }
  }
}
