{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.deagle": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='deagle' && q.is_using_item) || query.get_equipped_item_name=='deagle_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s deagle 7",
            "/event entity @s[hasitem={item=krep:deagle, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "deagle.31": "query.get_equipped_item_name=='deagle' && query.is_using_item && query.scoreboard('deagle') == 0"
            }
          ],
          "on_entry": ["/function deagle"]
        },
        "deagle.31": {
          "animations": ["deagleshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={deagle=0}] slot.weapon.mainhand 1 krep:deagle_emp 1 0"]
        }
      }
    }
  }
}
