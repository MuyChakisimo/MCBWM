{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.deagle": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='deagle' && q.is_using_item) || query.get_equipped_item_name=='deagle_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s deagle 7",
            "/event entity @s[hasitem={item=krep:deagle, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "deagle.30": "query.get_equipped_item_name=='deagle' && query.is_using_item && query.scoreboard('deagle') >= 1 && q.mark_variant != 2"
            },
            {
              "deagle.31": "query.get_equipped_item_name=='deagle' && query.is_using_item && query.scoreboard('deagle') == 0"
            }
          ],
          "on_entry": ["/function deagle"]
        },
        "deagle.31": {
          "animations": ["deagleshoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={deagle=0}] slot.weapon.mainhand 1 krep:deagle_emp 1 0"]
        },
        "deagle.30": {
          "animations": ["deagleshoot"],
          "transitions": [{"setup": "query.all_animations_finished && !q.is_using_item"}],
          "on_entry": [
            "@s krep:deagle_fire",
            "/scoreboard players remove @s[scores={deagle=1..8}] deagle 1",
            "/scoreboard players set @s[scores={deagle=9..}] deagle 8",
            "/playsound deagle.shoot @a[r=30]",
            "/replaceitem entity @s[scores={deagle=0}] slot.weapon.mainhand 1 krep:deagle_emp 1 0",
            "/title @s[scores={deagle=0}] actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.deagle.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='deagle_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='deagle' && variable.attack_time > 0.0f && query.scoreboard('deagle') <= 6 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='deagle')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function deaglequantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='deagle' && q.property('krep:ammoreload') == 70"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='deagle' && q.property('krep:ammoreload') >= 71"
            },
            {"setup": "query.get_equipped_item_name!='deagle'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function deaglequantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='deagle_emp' && q.property('krep:ammoreload') == 70"
            },
            {
              "reload": "query.get_equipped_item_name=='deagle_emp' && q.property('krep:ammoreload') >= 71"
            },
            {"setup": "query.get_equipped_item_name!='deagle'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "deaglereload": "query.get_equipped_item_name('main_hand')=='deagle_emp' || query.get_equipped_item_name('main_hand')=='deagle'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='deagle_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "deaglereloadtac": "query.get_equipped_item_name('main_hand')=='deagle_emp' || query.get_equipped_item_name('main_hand')=='deagle'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='deagle'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function deagle", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='deagle' || query.get_equipped_item_name=='deagle_emp'"
            }
          ]
        }
      }
    }
  }
}
