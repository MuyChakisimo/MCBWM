{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m320": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m320' && q.is_using_item) || query.get_equipped_item_name=='m320_emp'"
            }
          ],
          "on_entry": [
            "/event entity @s[hasitem={item=krep:m320, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m320.30": "query.get_equipped_item_name=='m320' && query.is_using_item && q.is_sneaking"
            }
          ],
          "on_entry": []
        },
        "m320.31": {
          "animations": ["m320shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s slot.weapon.mainhand 1 krep:m320_emp 1 0"]
        },
        "m320.30": {
          "animations": ["m320shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": [
            "@s krep:m320_fire",
            "/playsound m320.shoot @a[r=30]",
            "/replaceitem entity @s slot.weapon.mainhand 1 krep:m320_emp 1 0",
            "/title @s actionbar No Ammunition"
          ]
        }
      }
    },
    "controller.animation.m320.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [{"trigger.reload": "query.get_equipped_item_name=='m320_emp' && q.is_using_item"}]
        },
        "trigger.reload": {
          "on_entry": [
            "/event entity @s[hasitem={item=krep:grenade40,quantity=0}] m320reload0",
            "/event entity @s[hasitem={item=krep:grenade40,quantity=1..}] m320reload1",
            "@s krep:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m320_emp' && q.property('krep:ammoreload') == 1000"
            },
            {
              "reload": "query.get_equipped_item_name=='m320_emp' && q.property('krep:ammoreload') >= 1001"
            },
            {"setup": "query.get_equipped_item_name=='m320'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m320reload": "query.get_equipped_item_name('main_hand')=='m320_emp' || query.get_equipped_item_name('main_hand')=='m320'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m320_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m320' || query.get_equipped_item_name=='m320_emp'"
            }
          ]
        }
      }
    }
  }
}
