{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m320": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m320' && q.is_using_item) || query.get_equipped_item_name=='m320_emp'"
            }
          ],
          "on_entry": [
            "/event entity @s[hasitem={item=krep:m320, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {"transitions": [], "on_entry": []},
        "m320.31": {
          "animations": ["m320shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s slot.weapon.mainhand 1 krep:m320_emp 1 0"]
        }
      }
    }
  }
}
