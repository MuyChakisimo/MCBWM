{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m1911": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m1911' && q.is_using_item) || query.get_equipped_item_name=='m1911_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m1911 7",
            "/event entity @s[hasitem={item=krep:m1911, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m1911.31": "query.get_equipped_item_name=='m1911' && query.is_using_item && query.scoreboard('m1911') == 0"
            }
          ],
          "on_entry": ["/function m1911"]
        },
        "m1911.31": {
          "animations": ["m1911shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m1911=0}] slot.weapon.mainhand 1 krep:m1911_emp 1 0"]
        }
      }
    },
    "controller.animation.m1911.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m1911_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m1911' && variable.attack_time > 0.0f && query.scoreboard('m1911') <= 6 && q.mark_variant != 3) || (q.mark_variant == 2 && query.get_equipped_item_name=='m1911')"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m1911quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m1911' && q.property('krep:ammoreload') == 500"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='m1911' && q.property('krep:ammoreload') >= 501"
            },
            {"setup": "query.get_equipped_item_name!='m1911'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m1911quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m1911_emp' && q.property('krep:ammoreload') == 500"
            },
            {
              "reload": "query.get_equipped_item_name=='m1911_emp' && q.property('krep:ammoreload') >= 501"
            },
            {"setup": "query.get_equipped_item_name!='m1911'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m1911reload": "query.get_equipped_item_name('main_hand')=='m1911_emp' || query.get_equipped_item_name('main_hand')=='m1911'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m1911_emp'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m1911reloadtac": "query.get_equipped_item_name('main_hand')=='m1911_emp' || query.get_equipped_item_name('main_hand')=='m1911'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "on_exit": ["@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m1911'"},
            {"reloadfinish": "query.all_animations_finished"}
          ]
        },
        "reloadfinish": {
          "on_entry": ["/function m1911", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m1911' || query.get_equipped_item_name=='m1911_emp'"
            }
          ]
        }
      }
    }
  }
}
