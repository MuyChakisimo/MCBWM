{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m870": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m870' && q.is_using_item) || query.get_equipped_item_name=='m870_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m870 5",
            "/event entity @s[hasitem={item=krep:m870, location=slot.weapon.mainhand}] krep:noreload",
            "@s m870:normal"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m870.31": "query.get_equipped_item_name=='m870' && query.is_using_item && query.scoreboard('m870') == 0"
            }
          ],
          "on_entry": ["/function m870"]
        },
        "m870.31": {
          "animations": ["m870shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={m870=0}] slot.weapon.mainhand 1 krep:m870_emp 1 0"]
        }
      }
    },
    "controller.animation.m870.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": ["@s krep:noreload"],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m870_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m870' && variable.attack_time > 0.0f && query.scoreboard('m870') <= 4 && q.mark_variant != 3 && q.property('krep:ammoreload')!=3) || (q.mark_variant == 2 && query.get_equipped_item_name=='m870' && q.property('krep:ammoreload')!=3)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": ["/function m870quantity", "@s krep:noreload"],
          "transitions": [
            {"setup": "query.get_equipped_item_name=='m870' && q.property('krep:ammoreload') == 410"},
            {
              "reload.tac": "query.get_equipped_item_name=='m870' && q.property('krep:ammoreload') >= 411"
            },
            {"setup": "query.get_equipped_item_name!='m870'"}
          ]
        },
        "trigger.reload": {
          "on_entry": ["/function m870quantity", "@s krep:noreload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m870_emp' && q.property('krep:ammoreload') == 410"
            },
            {
              "reload": "query.get_equipped_item_name=='m870_emp' && q.property('krep:ammoreload') >= 411"
            },
            {"setup": "query.get_equipped_item_name!='m870'"}
          ]
        },
        "reload": {
          "animations": [
            {
              "m870reload": "query.get_equipped_item_name('main_hand')=='m870_emp' || query.get_equipped_item_name('main_hand')=='m870'"
            }
          ],
          "on_entry": ["@s krep:reload"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name!='m870_emp' && query.get_equipped_item_name!='m870'"
            },
            {
              "reloadfinish1": "query.get_equipped_item_name=='m870' && q.is_using_item && query.scoreboard('m870') >= 1"
            },
            {
              "reloadfinish1": "query.get_equipped_item_name=='m870' && q.property('krep:ammoreload') == 410"
            },
            {
              "reloadfinish1": "query.get_equipped_item_name=='m870' && query.scoreboard('m870') == 5"
            }
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m870reloadtac": "query.get_equipped_item_name('main_hand')=='m870_emp' || query.get_equipped_item_name('main_hand')=='m870'"
            }
          ],
          "on_entry": ["@s krep:reloadtac"],
          "transitions": [
            {"setup": "query.get_equipped_item_name!='m870'"},
            {"reloadfinish": "query.get_equipped_item_name=='m870' && query.scoreboard('m870') == 6"},
            {
              "reloadfinish": "query.get_equipped_item_name=='m870' && q.property('krep:ammoreload') == 410"
            },
            {
              "reloadfinish": "query.get_equipped_item_name=='m870' && q.is_using_item && query.scoreboard('m870') >= 1"
            }
          ]
        },
        "reloadfinish1": {
          "animations": [
            {
              "m870end": "query.get_equipped_item_name('main_hand')=='m870_emp' || query.get_equipped_item_name('main_hand')=='m870'"
            }
          ],
          "on_entry": ["/function m870", "@s krep:reload", "@s m870:end"],
          "on_exit": ["@s krep:noreload", "@s m870:normal"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp'"
            }
          ]
        },
        "reloadfinish": {
          "animations": [
            {
              "m870end": "query.get_equipped_item_name('main_hand')=='m870_emp' || query.get_equipped_item_name('main_hand')=='m870'"
            }
          ],
          "on_entry": ["/function m870", "@s krep:reloadtac", "@s m870:end"],
          "on_exit": ["@s krep:noreload", "@s m870:normal"],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp'"
            }
          ]
        }
      }
    }
  }
}
