{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hk416": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='hk416' && q.is_using_item) || query.get_equipped_item_name=='hk416_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s hk416 30",
            "/event entity @s[hasitem={item=krep:hk416, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "hk416.31": "query.get_equipped_item_name=='hk416' && query.is_using_item && query.scoreboard('hk416') == 0"
            }
          ],
          "on_entry": ["/function hk416"]
        },
        "hk416.31": {
          "animations": ["hk416shoot"],
          "transitions": [{"setup": "query.all_animations_finished"}],
          "on_entry": ["/replaceitem entity @s[scores={hk416=0}] slot.weapon.mainhand 1 krep:hk416_emp 1 0"]
        }
      }
    }
  }
}
