{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:player",
      "spawn_category": "creature",
      "is_spawnable": false,
      "is_summonable": false,
      "is_experimental": false,
      "properties": {
        "krep:movement": {"range": [0, 10], "default": 0, "type": "int", "client_sync": true},
        "krep:view": {"range": [0, 10], "default": 0, "type": "int", "client_sync": true},
        "krep:bulletcache": {"range": [0, 9999], "default": 0, "type": "int", "client_sync": true},
        "krep:bulletcachemk2": {"range": [0, 9999], "default": 0, "type": "int", "client_sync": true},
        "krep:stock": {"range": [0, 15], "default": 0, "type": "int", "client_sync": true},
        "krep:grip": {"range": [0, 15], "default": 0, "type": "int", "client_sync": true},
        "krep:magazine": {"range": [0, 5], "default": 0, "type": "int", "client_sync": true},
        "krep:laser": {"range": [0, 15], "default": 0, "type": "int", "client_sync": true},
        "krep:muzzle": {"range": [0, 15], "default": 0, "type": "int", "client_sync": true},
        "krep:akmscope": {
          "values": ["nothing", "elcan", "acog", "coyote", "okp7", "holo"],
          "default": "nothing",
          "type": "enum",
          "client_sync": true
        },
        "krep:falscope": {"values": ["nothing", "coyote"], "default": "nothing", "type": "enum", "client_sync": true},
        "krep:qbz191scope": {"values": ["nothing", "coyote"], "default": "nothing", "type": "enum", "client_sync": true},
        "krep:mk14scope": {"values": ["nothing", "coyote"], "default": "nothing", "type": "enum", "client_sync": true},
        "krep:mp5scope": {
          "values": ["nothing", "coyote", "t2", "holo"],
          "default": "nothing",
          "type": "enum",
          "client_sync": true
        },
        "krep:vectorscope": {
          "values": ["nothing", "coyote", "t2", "holo"],
          "default": "nothing",
          "type": "enum",
          "client_sync": true
        },
        "krep:m4a1scope": {
          "values": ["nothing", "elcan", "acog", "coyote", "t2", "holo"],
          "default": "nothing",
          "type": "enum",
          "client_sync": true
        },
        "krep:hk416scope": {
          "values": ["nothing", "elcan", "acog", "coyote", "t2", "holo"],
          "default": "nothing",
          "type": "enum",
          "client_sync": true
        },
        "krep:awpscope": {
          "values": ["nothing", "elcan", "acog", "coyote", "standard_8"],
          "default": "nothing",
          "type": "enum",
          "client_sync": true
        },
        "krep:m107scope": {
          "values": ["nothing", "elcan", "acog", "coyote", "standard_8"],
          "default": "nothing",
          "type": "enum",
          "client_sync": true
        },
        "krep:ammoreload": {"range": [0, 9999], "default": 30, "type": "int", "client_sync": true},
        "krep:held": {"range": [0, 255], "default": 0, "type": "int", "client_sync": true}
      }
    },
    "component_groups": {
      "krep:reload": {"minecraft:mark_variant": {"value": 1}},
      "krep:noreload": {"minecraft:mark_variant": {"value": 0}},
      "krep:reloadtac": {"minecraft:mark_variant": {"value": 2}},
      "krep:inspect": {"minecraft:skin_id": {"value": 1}},
      "krep:noinspect": {"minecraft:skin_id": {"value": 0}},
      "krep:attachmentmode": {"minecraft:skin_id": {"value": 2}},
      "minecraft:add_raid_omen": {
        "minecraft:spell_effects": {
          "add_effects": [{"effect": "raid_omen", "duration": 30, "display_on_screen_animation": true}],
          "remove_effects": "bad_omen"
        },
        "minecraft:timer": {
          "time": [0, 0],
          "looping": false,
          "time_down_event": {"event": "minecraft:clear_add_raid_omen", "target": "self"}
        }
      },
      "minecraft:clear_raid_omen_spell_effect": {"minecraft:spell_effects": {}},
      "minecraft:raid_trigger": {
        "minecraft:raid_trigger": {"triggered_event": {"event": "minecraft:remove_raid_trigger", "target": "self"}}
      }
    },
    "components": {
      "minecraft:experience_reward": {"on_death": "Math.Min(query.player_level * 7, 100)"},
      "minecraft:type_family": {"family": ["player"]},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:loot": {"table": "loot_tables/empty.json"},
      "minecraft:collision_box": {"width": 0.6, "height": 1.8},
      "minecraft:can_climb": {},
      "minecraft:movement": {"value": 0.1},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {"test": "in_lava", "subject": "self", "operator": "==", "value": true},
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:attack": {"damage": 1},
      "minecraft:exhaustion_values": {
        "heal": 6,
        "jump": 0.05,
        "sprint_jump": 0.2,
        "mine": 0.005,
        "attack": 0.1,
        "damage": 0.1,
        "walk": 0,
        "sprint": 0.1,
        "swim": 0.01
      },
      "minecraft:player.saturation": {"value": 5, "max": 20},
      "minecraft:player.exhaustion": {"value": 0, "max": 20},
      "minecraft:player.level": {"value": 0, "max": 24791},
      "minecraft:player.experience": {"value": 0, "max": 1},
      "minecraft:breathable": {"total_supply": 15, "suffocate_time": -1, "inhale_time": 3.75, "generates_bubbles": false},
      "minecraft:nameable": {"always_show": true, "allow_name_tag_renaming": false},
      "minecraft:physics": {"push_towards_closest_space": true},
      "minecraft:pushable": {"is_pushable": false, "is_pushable_by_piston": true},
      "minecraft:insomnia": {"days_until_insomnia": 3},
      "minecraft:rideable": {
        "seat_count": 2,
        "family_types": ["parrot_tame"],
        "pull_in_entities": true,
        "seats": [
          {
            "position": [0.4, -0.2, -0.1],
            "min_rider_count": 0,
            "max_rider_count": 0,
            "lock_rider_rotation": 0
          },
          {
            "position": [-0.4, -0.2, -0.1],
            "min_rider_count": 1,
            "max_rider_count": 2,
            "lock_rider_rotation": 0
          }
        ]
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:block_climber": {},
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "all_of": [
              {"test": "has_mob_effect", "subject": "self", "value": "bad_omen"},
              {"test": "is_in_village", "subject": "self", "value": true}
            ]
          },
          "event": "minecraft:gain_raid_omen"
        }
      }
    },
    "events": {
      "krep:reload": {"add": {"component_groups": ["krep:reload"]}},
      "krep:noreload": {"add": {"component_groups": ["krep:noreload"]}},
      "krep:reloadtac": {"add": {"component_groups": ["krep:reloadtac"]}},
      "minecraft:gain_bad_omen": {"add": {"component_groups": ["minecraft:add_bad_omen"]}},
      "minecraft:clear_add_bad_omen": {
        "remove": {"component_groups": []},
        "add": {"component_groups": ["minecraft:clear_bad_omen_spell_effect"]}
      },
      "m870:normal": {"set_property": {"krep:ammoreload": 0}},
      "spas12:normal": {"set_property": {"krep:ammoreload": 0}},
      "m870:bolt": {"set_property": {"krep:ammoreload": 3}},
      "spas12:bolt": {"set_property": {"krep:ammoreload": 3}},
      "hk416:ironsight": {"set_property": {"krep:hk416scope": "'nothing'"}},
