      "mp5:coyote": {"set_property": {"krep:mp5scope": "'coyote'"}},
      "mp5:holo": {"set_property": {"krep:mp5scope": "'holo'"}},
      "mp5:t2": {"set_property": {"krep:mp5scope": "'t2'"}},
      "vector:ironsight": {"set_property": {"krep:vectorscope": "'nothing'"}},
      "vector:coyote": {"set_property": {"krep:vectorscope": "'coyote'"}},
      "vector:holo": {"set_property": {"krep:vectorscope": "'holo'"}},
      "vector:t2": {"set_property": {"krep:vectorscope": "'t2'"}},
      "m4a1:ironsight": {"set_property": {"krep:m4a1scope": "'nothing'"}},
      "m4a1:elcan": {"set_property": {"krep:m4a1scope": "'elcan'"}},
      "m4a1:coyote": {"set_property": {"krep:m4a1scope": "'coyote'"}},
      "m4a1:holo": {"set_property": {"krep:m4a1scope": "'holo'"}},
      "m4a1:t2": {"set_property": {"krep:m4a1scope": "'t2'"}},
      "m4a1:acog": {"set_property": {"krep:m4a1scope": "'acog'"}},
      "akm:ironsight": {"set_property": {"krep:akmscope": "'nothing'"}},
      "akm:elcan": {"set_property": {"krep:akmscope": "'elcan'"}},
      "akm:coyote": {"set_property": {"krep:akmscope": "'coyote'"}},
      "akm:holo": {"set_property": {"krep:akmscope": "'holo'"}},
      "akm:okp7": {"set_property": {"krep:akmscope": "'okp7'"}},
      "akm:acog": {"set_property": {"krep:akmscope": "'acog'"}},
      "awp:bolt": {"set_property": {"krep:ammoreload": 1}},
      "m700:bolt": {"set_property": {"krep:ammoreload": 1}},
      "kar98:bolt": {"set_property": {"krep:ammoreload": 1}},
      "awp:normal": {"set_property": {"krep:ammoreload": 0}},
      "m700:normal": {"set_property": {"krep:ammoreload": 0}},
      "kar98:normal": {"set_property": {"krep:ammoreload": 0}},
      "awp:ironsight": {"set_property": {"krep:awpscope": "'nothing'"}},
      "awp:elcan": {"set_property": {"krep:awpscope": "'elcan'"}},
      "awp:coyote": {"set_property": {"krep:awpscope": "'coyote'"}},
      "awp:standard_8": {"set_property": {"krep:awpscope": "'standard_8'"}},
      "awp:acog": {"set_property": {"krep:awpscope": "'acog'"}},
      "m107:ironsight": {"set_property": {"krep:m107scope": "'nothing'"}},
      "m107:elcan": {"set_property": {"krep:m107scope": "'elcan'"}},
      "m107:coyote": {"set_property": {"krep:m107scope": "'coyote'"}},
      "m107:standard_8": {"set_property": {"krep:m107scope": "'standard_8'"}},
      "m107:acog": {"set_property": {"krep:m107scope": "'acog'"}},
      "krep:attachmentmode": {
        "sequence": [
          {
            "filters": {"any_of": [{"test": "is_mark_variant", "subject": "self", "value": 2, "operator": "!="}]},
            "add": {"component_groups": ["krep:attachmentmode"]},
            "queue_command": {
              "command": [
                "tag @s add attachmentmode",
                "tag @s remove stockmode",
                "tag @s remove scopemode",
                "tag @s remove miscmode",
                "tag @s remove gripmode"
              ]
            }
          }
        ]
      },
      "krep:inspect": {"add": {"component_groups": ["krep:inspect"]}},
      "krep:view": {"add": {"component_groups": ["krep:attachmentmode"]}},
      "krep:noinspect": {"add": {"component_groups": ["krep:noinspect"]}},
      "krep:noview": {
        "sequence": [
          {
            "filters": {"any_of": [{"test": "is_skin_id", "subject": "self", "value": 2, "operator": "=="}]},
            "add": {"component_groups": ["krep:noinspect"]}
          }
        ]
      },
      "evolys:reset": {"set_property": {"krep:bulletcachemk2": 0}},
      "evolys:bulletcache": {"set_property": {"krep:bulletcachemk2": 1}},
      "mk14:ironsight": {"set_property": {"krep:mk14scope": "'nothing'"}},
      "mk14:coyote": {"set_property": {"krep:mk14scope": "'coyote'"}},
      "qbz191:ironsight": {"set_property": {"krep:qbz191scope": "'nothing'"}},
      "qbz191:coyote": {"set_property": {"krep:qbz191scope": "'coyote'"}},
      "minecraft:gain_raid_omen": {"add": {"component_groups": ["minecraft:add_raid_omen"]}},
      "minecraft:clear_add_raid_omen": {
