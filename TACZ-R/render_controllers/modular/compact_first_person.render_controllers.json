{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.player.compact_weapons.first_person": {
      "arrays": {
        "geometries": {
          "Array.compact_fp_geometry": [
            "Geometry.taczuniversal27",
            "Geometry.taczuniversal28",
            "Geometry.taczuniversal29"
          ]
        }
      },
      "geometry": "Array.compact_fp_geometry[v.compact_fp_render_index]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'map' || v.t50 || v.cp || v.type81"
        },
        {
          "rightSleeve": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'map' || v.t50 || v.cp || v.type81"
        },
        {
          "leftArm": "(query.get_equipped_item_name(0, 1) == 'map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0)) || v.t50 || v.cp || v.type81"
        },
        {
          "leftSleeve": "(query.get_equipped_item_name(0, 1) == 'map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0)) || v.t50 || v.cp || v.type81"
        }
      ]
    }
  }
}