{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m320.walk": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "transitions": [{"walk": "v.m320 && q.is_moving && !q.is_sprinting && !q.is_sneaking"}]
        },
        "walk": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"universal_walk": "v.m320"}, {"walk_delay_2": "v.m320"}],
          "transitions": [
            {"delay": "v.m320 && q.is_sprinting"},
            {"delay": "v.m320 && q.is_sneaking"},
            {"delay": "v.m320 && !q.is_moving && !q.is_sprinting && q.any_animation_finished"}
          ]
        },
        "delay": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"walk_delay": "v.m320"}],
          "transitions": [{"setup": "v.m320 && q.any_animation_finished"}]
        }
      }
    },
    "controller.animation.m320.tp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [{"m320_tp_hold": "v.m320"}],
          "transitions": [{"sight": "v.m320 && q.is_sneaking"}, {"hold": "v.m320 && q.is_using_item"}]
        },
        "sight": {
          "animations": [{"m320_tp_sight": "v.m320"}],
          "transitions": [{"hold": "v.m320 && !q.is_sneaking"}]
        }
      }
    },
    "controller.animation.m320.fp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"m320_fp_hold": "v.m320"}],
          "transitions": [
            {"reload": "v.m320emp && q.mark_variant == 1"},
            {"inspect": "v.m320 && q.skin_id == 1 && !q.is_sneaking"},
            {"sight": "v.m320 && q.is_sneaking"},
            {"hold": "v.m320 && q.is_using_item"}
          ]
        },
        "inspect": {
          "animations": [{"m320_fp_inspect": "v.m320b"}, {"m320_fp_inspect_emp": "v.m320emp"}],
          "transitions": [
            {
              "hold": "(v.m320 && q.any_animation_finished) || (v.m320 && q.is_using_item) || (v.m320 && q.is_sneaking)"
            }
          ]
        },
        "reload": {
          "animations": [{"m320_fp_reload": "v.m320"}],
          "transitions": [{"hold": "v.m320 && (q.any_animation_finished || q.mark_variant != 1)"}]
        },
        "sight": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"m320_fp_sight": "v.m320"}],
          "transitions": [{"hold": "v.m320 && !q.is_sneaking"}, {"reload": "v.m320emp && q.mark_variant == 1"}]
        }
      }
    }
  }
}
