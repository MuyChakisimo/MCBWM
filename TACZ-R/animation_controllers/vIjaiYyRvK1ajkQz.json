{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m107.walk": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "walk": "v.m107 && q.is_moving && !q.is_sprinting && !q.is_sneaking"
            }
          ]
        },
        "walk": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [
            {
              "universal_walk": "v.m107"
            },
            {
              "walk_delay_2": "v.m107"
            }
          ],
          "transitions": [
            {
              "delay": "v.m107 && q.is_sprinting"
            },
            {
              "delay": "v.m107 && q.is_sneaking"
            },
            {
              "delay": "v.m107 && !q.is_moving && !q.is_sprinting && q.any_animation_finished"
            }
          ]
        },
        "delay": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [
            {
              "walk_delay": "v.m107"
            }
          ],
          "transitions": [
            {
              "setup": "v.m107 && q.any_animation_finished"
            }
          ]
        }
      }
    },
    "controller.animation.m107.tp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [
            {
              "m107_tp_hold": "v.m107"
            }
          ],
          "transitions": [
            {
              "sprint": "v.m107 && q.is_sprinting && !q.is_using_item"
            },
            {
              "sight": "v.m107 && q.is_sneaking"
            },
            {
              "hold": "v.m107 && q.is_using_item"
            }
          ]
        },
        "sprint": {
          "animations": [
            {
              "m107_tp_sprint": "v.m107"
            }
          ],
          "transitions": [
            {
              "hold": "v.m107 && !q.is_sprinting"
            },
            {
              "hold": "v.m107 && q.is_using_item"
            },
            {
              "sight": "v.m107 && q.is_sneaking"
            }
          ]
        },
        "sight": {
          "animations": [
            {
              "m107_tp_sight": "v.m107"
            }
          ],
          "transitions": [
            {
              "hold": "v.m107 && !q.is_sneaking"
            }
          ]
        }
      }
    },
    "controller.animation.m107.fp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "blend_transition": 0.16,
          "blend_via_shortest_path": true,
          "animations": [
            {
              "m107_fp_hold": "v.m107"
            }
          ],
          "transitions": [
            {
              "reload": "v.m107emp && q.mark_variant == 1"
            },
            {
              "inspect": "v.m107b && q.skin_id == 1 && !q.is_sneaking"
            },
            {
              "reloadtac": "v.m107 && q.mark_variant == 2"
            },
            {
              "sprint": "v.m107 && q.is_sprinting && !q.is_using_item"
            },
            {
              "sight": "v.m107 && q.is_sneaking"
            },
            {
              "hold": "v.m107 && q.is_using_item"
            }
          ]
        },
        "inspect": {
          "animations": [
            {
              "m107_fp_inspect": "v.m107"
            }
          ],
          "transitions": [
            {
              "hold": "(v.m107 && q.all_animations_finished) || (v.m107 && q.is_using_item) || (v.m107 && q.is_sneaking)"
            }
          ]
        },
        "sprint": {
          "blend_transition": 0.16,
          "blend_via_shortest_path": true,
          "animations": [
            {
              "m107_fp_sprint": "v.m107"
            }
          ],
          "transitions": [
            {
              "hold": "v.m107 && !q.is_sprinting"
            },
            {
              "hold": "v.m107 && q.is_using_item"
            },
            {
              "reload": "v.m107emp && q.mark_variant == 1"
            },
            {
              "reloadtac": "v.m107 && q.mark_variant == 2"
            },
            {
              "sight": "v.m107 && q.is_sneaking"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "m107_fp_reload": "v.m107"
            }
          ],
          "transitions": [
            {
              "hold": "v.m107 && (q.all_animations_finished || q.mark_variant != 1)"
            }
          ]
        },
        "reloadtac": {
          "animations": [
            {
              "m107_fp_reload_tac": "v.m107"
            }
          ],
          "transitions": [
            {
              "hold": "v.m107 && q.all_animations_finished"
            },
            {
              "hold": "v.m107b && q.mark_variant != 2"
            }
          ]
        },
        "sight": {
          "blend_transition": 0.16,
          "blend_via_shortest_path": true,
          "animations": [
            {
              "m107_fp_sight": "v.m107 && q.property('krep:m107scope')=='nothing'"
            },
            {
              "m107_fp_sight_coyote": "v.m107 && q.property('krep:m107scope')=='coyote'"
            },
            {
              "m107_fp_sight_elcan": "v.m107 && q.property('krep:m107scope')=='elcan'"
            },
            {
              "m107_fp_sight_acog": "v.m107 && q.property('krep:m107scope')=='acog'"
            },
            {
              "m107_fp_sight_standard_8": "v.m107 && q.property('krep:m107scope')=='standard_8'"
            }
          ],
          "transitions": [
            {
              "hold": "v.m107 && !q.is_sneaking"
            },
            {
              "reloadtac": "v.m107 && q.mark_variant == 2"
            },
            {
              "reload": "v.m107emp && q.mark_variant == 1"
            }
          ]
        }
      }
    }
  }
}
