{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.l85.recoil": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"shootdelay": "q.is_using_item && q.property('krep:l85reload') != 0"}],
          "transitions": [
            {
              "shoot.hip": "v.l85b && q.is_using_item && q.mark_variant == 0 && !q.is_sneaking && q.all_animations_finished"
            },
            {
              "shoot.sight": "v.l85b && q.is_using_item && q.mark_variant == 0 && q.is_sneaking && q.all_animations_finished"
            }
          ]
        },
        "shoot.hip": {
          "blend_transition": 0.3,
          "blend_via_shortest_path": true,
          "animations": [{"l85_recoil": "v.l85 && q.property('krep:l85reload') != 0"}],
          "transitions": [
            {
              "setup": "!v.l85b || !q.is_using_item || q.mark_variant != 0 || q.is_sneaking || q.property('krep:l85reload') == 0"
            }
          ]
        },
        "shoot.sight": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"recoil_sight": "v.l85 && q.property('krep:l85reload') != 0"}],
          "transitions": [
            {
              "setup": "!v.l85b || !q.is_using_item || q.mark_variant != 0 || !q.is_sneaking || q.property('krep:l85reload') == 0"
            }
          ]
        }
      }
    }
  }
}
