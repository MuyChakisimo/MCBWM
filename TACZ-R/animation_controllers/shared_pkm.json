{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.pkm.walk": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "transitions": [{"walk": "v.pkm && q.is_moving && !q.is_sprinting && !q.is_sneaking"}]
        },
        "walk": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"m9_fp_walk": "v.pkm"}, {"walk_delay_2": "v.pkm"}],
          "transitions": [
            {"delay": "v.pkm && q.is_sprinting"},
            {"delay": "v.pkm && q.is_sneaking"},
            {"delay": "v.pkm && !q.is_moving && !q.is_sprinting && q.any_animation_finished"}
          ]
        },
        "delay": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"walk_delay": "v.pkm"}],
          "transitions": [{"setup": "v.pkm && q.any_animation_finished"}]
        }
      }
    },
    "controller.animation.pkm.fp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"pkm_fp_hold": "v.pkm"}],
          "transitions": [
            {"reload": "v.pkmemp && q.mark_variant == 1"},
            {"inspect": "v.pkm && q.all_animations_finished && !q.is_sneaking"},
            {"reloadtac": "v.pkm && q.mark_variant == 2"},
            {"sprint": "v.pkm && q.is_sprinting && !q.is_using_item"},
            {"sight": "v.pkm && q.is_sneaking"},
            {"hold": "v.pkm && q.is_using_item"}
          ]
        },
        "inspect": {
          "animations": [{"pkm_fp_inspect": "v.pkm"}],
          "transitions": [
            {
              "hold": "(v.pkm && q.all_animations_finished) || (v.pkm && q.is_using_item) || (v.pkm && q.is_sneaking)"
            }
          ]
        },
        "sprint": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"pkm_fp_sprint": "v.pkm"}],
          "transitions": [
            {"hold": "v.pkm && !q.is_sprinting"},
            {"hold": "v.pkm && q.is_using_item"},
            {"reload": "v.pkmemp && q.mark_variant == 1"},
            {"reloadtac": "v.pkm && q.mark_variant == 2"},
            {"sight": "v.pkm && q.is_sneaking"}
          ]
        },
        "reload": {
          "animations": [{"pkm_fp_reload": "v.pkm"}],
          "transitions": [{"hold": "v.pkm && (q.all_animations_finished || q.mark_variant !=1)"}]
        },
        "reloadtac": {
          "animations": [{"pkm_fp_reload_tac": "v.pkm"}],
          "transitions": [{"hold": "v.pkm && q.all_animations_finished"}, {"hold": "v.pkmb && q.mark_variant != 2"}]
        },
        "sight": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"pkm_fp_sight": "v.pkm"}],
          "transitions": [
            {"hold": "v.pkm && !q.is_sneaking"},
            {"reloadtac": "v.pkm && q.mark_variant == 2"},
            {"reload": "v.pkmemp && q.mark_variant == 1"}
          ]
        }
      }
    },
    "controller.animation.pkm.recoil": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"shootdelay": "q.is_using_item && q.property('krep:l85reload') != 160"}],
          "transitions": [
            {
              "shoot.hip": "v.pkmb && q.is_using_item && q.mark_variant == 0 && !q.is_sneaking && q.all_animations_finished"
            },
            {
              "shoot.sight": "v.pkmb && q.is_using_item && q.mark_variant == 0 && q.is_sneaking && q.all_animations_finished"
            }
          ]
        },
        "shoot.hip": {
          "blend_transition": 0.3,
          "blend_via_shortest_path": true,
          "animations": [{"pkm_recoil": "v.pkm && q.property('krep:l85reload') != 160"}],
          "transitions": [
            {
              "setup": "!v.pkmb || !q.is_using_item || q.mark_variant != 0 || q.is_sneaking || q.property('krep:l85reload') == 160"
            }
          ]
        },
        "shoot.sight": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"pkm_recoil": "v.pkm && q.property('krep:l85reload') != 160"}],
          "transitions": [
            {
              "setup": "!v.pkmb || !q.is_using_item || q.mark_variant != 0 || !q.is_sneaking || q.property('krep:l85reload') == 160"
            }
          ]
        }
      }
    }
  }
}
