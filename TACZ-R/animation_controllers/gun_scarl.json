{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scarl.walk": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "transitions": [{"walk": "v.scarl && q.is_moving && !q.is_sprinting && !q.is_sneaking"}]
        },
        "walk": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"universal_walk": "v.scarl"}, {"walk_delay_2": "v.scarl"}],
          "transitions": [
            {"delay": "v.scarl && q.is_sprinting"},
            {"delay": "v.scarl && q.is_sneaking"},
            {"delay": "v.scarl && !q.is_moving && !q.is_sprinting && q.any_animation_finished"}
          ]
        },
        "delay": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"walk_delay": "v.scarl"}],
          "transitions": [{"setup": "v.scarl && q.any_animation_finished"}]
        }
      }
    },
    "controller.animation.scarl.tp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [{"scarl_tp_hold": "v.scarl"}],
          "transitions": [
            {"sprint": "v.scarl && q.is_sprinting && !q.is_using_item"},
            {"sight": "v.scarl && q.is_sneaking"},
            {"hold": "v.scarl && q.is_using_item"}
          ]
        },
        "sprint": {
          "animations": [{"scarl_tp_sprint": "v.scarl"}],
          "transitions": [
            {"hold": "v.scarl && !q.is_sprinting"},
            {"hold": "v.scarl && q.is_using_item"},
            {"sight": "v.scarl && q.is_sneaking"}
          ]
        },
        "sight": {
          "animations": [{"scarl_tp_sight": "v.scarl"}],
          "transitions": [{"hold": "v.scarl && !q.is_sneaking"}]
        }
      }
    },
    "controller.animation.scarl.fp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "blend_transition": 0.16,
          "blend_via_shortest_path": true,
          "animations": [{"scarl_fp_hold": "v.scarl"}],
          "transitions": [
            {"reload": "v.scarlemp && q.mark_variant == 1"},
            {"inspect": "v.scarlb && q.skin_id == 1 && !q.is_sneaking"},
            {"reloadtac": "v.scarl && q.mark_variant == 2"},
            {"sprint": "v.scarl && q.is_sprinting && !q.is_using_item"},
            {"sight": "v.scarl && q.is_sneaking"},
            {"hold": "v.scarl && q.is_using_item"}
          ]
        },
        "inspect": {
          "animations": [{"scarl_fp_inspect": "v.scarl"}],
          "transitions": [
            {
              "hold": "(v.scarl && q.all_animations_finished) || (v.scarl && q.is_using_item) || (v.scarl && q.is_sneaking)"
            }
          ]
        },
        "sprint": {
          "blend_transition": 0.16,
          "blend_via_shortest_path": true,
          "animations": [{"scarl_fp_sprint": "v.scarl"}],
          "transitions": [
            {"hold": "v.scarl && !q.is_sprinting"},
            {"hold": "v.scarl && q.is_using_item"},
            {"reload": "v.scarlemp && q.mark_variant == 1"},
            {"reloadtac": "v.scarl && q.mark_variant == 2"},
            {"sight": "v.scarl && q.is_sneaking"}
          ]
        },
        "reload": {
          "animations": [{"scarl_fp_reload": "v.scarl"}],
          "transitions": [{"hold": "v.scarl && (q.all_animations_finished || q.mark_variant != 1)"}]
        },
        "reloadtac": {
          "animations": [{"scarl_fp_reload_tac": "v.scarl"}],
          "transitions": [
            {"hold": "v.scarl && q.all_animations_finished"},
            {"hold": "v.scarlb && q.mark_variant != 2"}
          ]
        },
        "sight": {
          "blend_transition": 0.16,
          "blend_via_shortest_path": true,
          "animations": [{"scarl_fp_sight": "v.scarl"}],
          "transitions": [
            {"hold": "v.scarl && !q.is_sneaking"},
            {"reloadtac": "v.scarl && q.mark_variant == 2"},
            {"reload": "v.scarlemp && q.mark_variant == 1"}
          ]
        }
      }
    }
  }
}
