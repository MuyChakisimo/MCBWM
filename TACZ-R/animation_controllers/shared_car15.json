{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.car15.walk": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "transitions": [{"walk": "v.car15 && q.is_moving && !q.is_sprinting && !q.is_sneaking"}]
        },
        "walk": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"m9_fp_walk": "v.car15"}, {"walk_delay_2": "v.car15"}],
          "transitions": [
            {"delay": "v.car15 && q.is_sprinting"},
            {"delay": "v.car15 && q.is_sneaking"},
            {"delay": "v.car15 && !q.is_moving && !q.is_sprinting && q.any_animation_finished"}
          ]
        },
        "delay": {
          "blend_transition": 0.6,
          "blend_via_shortest_path": true,
          "animations": [{"walk_delay": "v.car15"}],
          "transitions": [{"setup": "v.car15 && q.any_animation_finished"}]
        }
      }
    },
    "controller.animation.car15.fp": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"car15_fp_hold": "v.car15"}],
          "transitions": [
            {"reload": "v.car15emp && q.mark_variant == 1"},
            {"inspect": "v.car15 && q.all_animations_finished && !q.is_sneaking"},
            {"reloadtac": "v.car15 && q.mark_variant == 2"},
            {"sprint": "v.car15 && q.is_sprinting && !q.is_using_item"},
            {"reload.gl": "v.car15b && q.mark_variant == 3 && q.property('krep:car15kit') == 1"},
            {"sight": "v.car15 && q.is_sneaking"},
            {"hold": "v.car15 && q.is_using_item"}
          ]
        },
        "inspect": {
          "animations": [{"car15_fp_inspect": "v.car15"}],
          "transitions": [
            {
              "hold": "(v.car15 && q.all_animations_finished) || (v.car15 && q.is_using_item) || (v.car15 && q.is_sneaking)"
            }
          ]
        },
        "sprint": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [{"car15_fp_sprint": "v.car15"}],
          "transitions": [
            {"hold": "v.car15 && !q.is_sprinting"},
            {"hold": "v.car15 && q.is_using_item"},
            {"reload.gl": "v.car15b && q.mark_variant == 3 && q.property('krep:car15kit') == 1"},
            {"reload": "v.car15emp && q.mark_variant == 1"},
            {"reloadtac": "v.car15 && q.mark_variant == 2"},
            {"sight": "v.car15 && q.is_sneaking"}
          ]
        },
        "reload.gl": {
          "animations": [{"car15_fp_glreload": "v.car15 && q.property('krep:car15kit') == 1"}],
          "transitions": [
            {"hold": "v.car15 && q.all_animations_finished"},
            {"hold": "v.car15 && q.mark_variant != 3"}
          ]
        },
        "reload": {
          "animations": [{"car15_fp_reload": "v.car15"}],
          "transitions": [
            {"hold": "v.car15 && q.all_animations_finished"},
            {"hold": "v.car15 && q.mark_variant != 1"}
          ]
        },
        "reloadtac": {
          "animations": [{"car15_fp_reload_tac": "v.car15"}],
          "transitions": [
            {"hold": "v.car15 && q.all_animations_finished"},
            {"hold": "v.car15b && q.mark_variant != 2"}
          ]
        },
        "sight": {
          "blend_transition": 0.13,
          "blend_via_shortest_path": true,
          "animations": [
            {"car15_fp_reddot_sight": "v.car15 && q.property('krep:car15sight') == 1"},
            {"car15_fp_sight": "v.car15 && q.property('krep:car15sight') == 0"}
          ],
          "transitions": [
            {"hold": "v.car15 && !q.is_sneaking"},
            {"reloadtac": "v.car15 && q.mark_variant == 2"},
            {"reload.gl": "v.car15b && q.mark_variant == 3 && q.property('krep:car15kit') == 1"},
            {"reload": "v.car15emp && q.mark_variant == 1"}
          ]
        }
      }
    }
  }
}
